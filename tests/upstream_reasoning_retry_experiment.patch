+++ b/internal/runtime/executor/codex_bridge_reasoning_retry_experiment_test.go
@@ -0,0 +1,548 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+const bridgeFixtureCreated = "data: {\"type\":\"response.created\",\"response\":{\"id\":\"first\",\"output\":[]}}\n\n"
+const bridgeFixtureReasoning = "data: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"reasoning\",\"summary\":[],\"encrypted_content\":\"SYNTHETIC_SIGNATURE\"}}\n\n"
+const bridgeFixtureError = "data: {\"type\":\"error\",\"error\":{\"type\":\"server_error\",\"code\":\"request_timeout\",\"message\":\"stream error: stream disconnected before completion: stream closed before response.completed\"}}\n\n"
+const bridgeFixtureOverload = "data: {\"type\":\"error\",\"error\":{\"type\":\"service_unavailable_error\",\"code\":\"server_is_overloaded\",\"message\":\"synthetic overload\"}}\n\n"
+const bridgeFixtureSuccess = "data: {\"type\":\"response.created\",\"response\":{\"id\":\"second\"}}\n\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"SYNTHETIC\"}\n\n"
+
+func TestBridgeReasoningRetryExperiment(t *testing.T) {
+	initial := bridgeFixtureCreated + bridgeFixtureReasoning + bridgeFixtureError
+	var out bytes.Buffer
+	attempts := 0
+	err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) {
+			attempts++
+			return io.NopCloser(strings.NewReader(bridgeFixtureSuccess)), nil
+		},
+		func() bool { return true })
+	if err != nil || attempts != 1 || out.String() != bridgeFixtureSuccess {
+		t.Fatalf("single safe retry failed: error=%v attempts=%d output_matches=%t", err, attempts, out.String() == bridgeFixtureSuccess)
+	}
+}
+
+func TestBridgeReasoningRetryOverloadIsExactBoundedAndWaits(t *testing.T) {
+	for name, tail := range map[string]string{
+		"event error":     bridgeFixtureOverload,
+		"response failed": "data: {\"type\":\"response.failed\",\"response\":{\"error\":{\"type\":\"service_unavailable_error\",\"code\":\"server_is_overloaded\",\"status_code\":503}}}\n\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			var out bytes.Buffer
+			waits, retries := 0, 0
+			err := bridgeReasoningRetryExperimentWithWait(context.Background(), &out,
+				io.NopCloser(strings.NewReader(bridgeFixtureCreated+bridgeFixtureReasoning+tail)),
+				func(context.Context) (io.ReadCloser, error) {
+					retries++
+					return io.NopCloser(strings.NewReader(bridgeFixtureSuccess)), nil
+				},
+				func() bool { return true }, func(context.Context) error { waits++; return nil })
+			if err != nil || waits != 1 || retries != 1 || out.String() != bridgeFixtureSuccess {
+				t.Fatal("synthetic overload did not wait for its bounded retry")
+			}
+		})
+	}
+	for name, tail := range map[string]string{
+		"wrong code":         strings.Replace(bridgeFixtureOverload, "server_is_overloaded", "different_error", 1),
+		"wrong type":         strings.Replace(bridgeFixtureOverload, "service_unavailable_error", "rate_limit_error", 1),
+		"quota status":       strings.Replace(bridgeFixtureOverload, `"code":`, `"status_code":429,"code":`, 1),
+		"malformed status":   strings.Replace(bridgeFixtureOverload, `"code":`, `"status_code":"503","code":`, 1),
+		"outer quota status": strings.Replace(bridgeFixtureOverload, `"type":"error",`, `"type":"error","status_code":429,`, 1),
+		"fractional status":  strings.Replace(bridgeFixtureOverload, `"code":`, `"status_code":503.5,"code":`, 1),
+		"duplicate status":   strings.Replace(bridgeFixtureOverload, `"code":`, `"status_code":503,"status_code":429,"code":`, 1),
+	} {
+		t.Run(name, func(t *testing.T) {
+			initial := bridgeFixtureCreated + tail
+			var out bytes.Buffer
+			waits, retries := 0, 0
+			err := bridgeReasoningRetryExperimentWithWait(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+				func(context.Context) (io.ReadCloser, error) { retries++; return nil, nil },
+				func() bool { return true }, func(context.Context) error { waits++; return nil })
+			if err != nil || waits != 0 || retries != 0 || out.String() != initial {
+				t.Fatal("different error must pass through unchanged")
+			}
+		})
+	}
+}
+
+func TestBridgeReasoningRetryOverloadChecksAccountAgainAfterWaiting(t *testing.T) {
+	initial := bridgeFixtureCreated + bridgeFixtureOverload
+	var out bytes.Buffer
+	same, waits, retries := true, 0, 0
+	err := bridgeReasoningRetryExperimentWithWait(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) { retries++; return nil, nil },
+		func() bool { return same }, func(context.Context) error { waits++; same = false; return nil })
+	if err != nil || waits != 1 || retries != 0 || out.String() != initial {
+		t.Fatal("account change during capacity wait must preserve the original failure")
+	}
+}
+
+func TestBridgeReasoningRetryOverloadWaitIsCancellable(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	waiting := make(chan struct{})
+	done := make(chan error, 1)
+	retries := 0
+	go func() {
+		done <- bridgeReasoningRetryExperimentWithWait(ctx, io.Discard,
+			io.NopCloser(strings.NewReader(bridgeFixtureCreated+bridgeFixtureOverload)),
+			func(context.Context) (io.ReadCloser, error) { retries++; return nil, nil },
+			func() bool { return true }, func(ctx context.Context) error { close(waiting); <-ctx.Done(); return ctx.Err() })
+	}()
+	<-waiting
+	cancel()
+	if err := <-done; !errors.Is(err, context.Canceled) || retries != 0 {
+		t.Fatal("cancellation must stop the capacity wait before retry")
+	}
+	cancelled, cancelImmediately := context.WithCancel(context.Background())
+	cancelImmediately()
+	if err := bridgeReasoningOverloadWait(cancelled); !errors.Is(err, context.Canceled) {
+		t.Fatal("the default jittered delay must be cancellation-aware")
+	}
+}
+
+func TestBridgeReasoningRetryOverloadStopsAtObservableEventsAndAttemptLimit(t *testing.T) {
+	for name, visible := range map[string]string{
+		"text":    "data: {\"type\":\"response.output_text.delta\",\"delta\":\"synthetic\"}\n\n",
+		"tool":    "data: {\"type\":\"response.output_item.added\",\"item\":{\"type\":\"function_call\"}}\n\n",
+		"unknown": "data: {\"type\":\"unknown.future.event\"}\n\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			initial := bridgeFixtureCreated + visible + bridgeFixtureOverload
+			var out bytes.Buffer
+			waits, retries := 0, 0
+			err := bridgeReasoningRetryExperimentWithWait(context.Background(), &out,
+				io.NopCloser(strings.NewReader(initial)),
+				func(context.Context) (io.ReadCloser, error) { retries++; return nil, nil },
+				func() bool { return true }, func(context.Context) error { waits++; return nil })
+			if err != nil || waits != 0 || retries != 0 || out.String() != initial {
+				t.Fatal("overload after an observable event must not be replayed")
+			}
+		})
+	}
+	initial := bridgeFixtureCreated + bridgeFixtureOverload
+	var out bytes.Buffer
+	waits, retries := 0, 0
+	err := bridgeReasoningRetryExperimentWithWait(context.Background(), &out,
+		io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) {
+			retries++
