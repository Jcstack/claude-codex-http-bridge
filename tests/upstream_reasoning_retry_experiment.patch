@@ -0,0 +1,310 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/tidwall/gjson"
+)
+
+const bridgeFixtureCreated = "data: {\"type\":\"response.created\",\"response\":{\"id\":\"first\",\"output\":[]}}\n\n"
+const bridgeFixtureReasoning = "data: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"reasoning\",\"summary\":[],\"encrypted_content\":\"SYNTHETIC_SIGNATURE\"}}\n\n"
+const bridgeFixtureError = "data: {\"type\":\"error\",\"error\":{\"type\":\"server_error\",\"code\":\"request_timeout\",\"message\":\"stream error: stream disconnected before completion: stream closed before response.completed\"}}\n\n"
+const bridgeFixtureSuccess = "data: {\"type\":\"response.created\",\"response\":{\"id\":\"second\"}}\n\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"SYNTHETIC\"}\n\n"
+
+func TestBridgeReasoningRetryExperiment(t *testing.T) {
+	initial := bridgeFixtureCreated + bridgeFixtureReasoning + bridgeFixtureError
+	var out bytes.Buffer
+	attempts := 0
+	err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) {
+			attempts++
+			return io.NopCloser(strings.NewReader(bridgeFixtureSuccess)), nil
+		},
+		func() bool { return true })
+	if err != nil || attempts != 1 || out.String() != bridgeFixtureSuccess {
+		t.Fatalf("single safe retry failed: error=%v attempts=%d output_matches=%t", err, attempts, out.String() == bridgeFixtureSuccess)
+	}
+}
+
+func TestBridgeReasoningRetryStopsAtObservableOrUnknownEvents(t *testing.T) {
+	cases := map[string]string{
+		"visible text":        `{"type":"response.output_text.delta","delta":"text"}`,
+		"visible summary":     `{"type":"response.reasoning_summary_text.delta","delta":"thought"}`,
+		"client tool":         `{"type":"response.output_item.added","item":{"type":"function_call","arguments":""}}`,
+		"server tool":         `{"type":"response.output_item.added","item":{"type":"web_search_call"}}`,
+		"reasoning summary":   `{"type":"response.output_item.done","item":{"type":"reasoning","summary":[{"text":"thought"}]}}`,
+		"unknown":             `{"type":"new.provider.event"}`,
+		"quota metadata":      `{"type":"codex.rate_limits","rate_limits":{}}`,
+		"moderation metadata": `{"type":"response.metadata","metadata":{}}`,
+		"malformed":           `{malformed`,
+		"completed":           `{"type":"response.completed"}`,
+	}
+	for name, payload := range cases {
+		t.Run(name, func(t *testing.T) {
+			initial := bridgeFixtureCreated + "data: " + payload + "\n\n" + bridgeFixtureError
+			var out bytes.Buffer
+			attempts := 0
+			err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+				func(context.Context) (io.ReadCloser, error) { attempts++; return nil, nil }, func() bool { return true })
+			if err != nil || attempts != 0 || out.String() != initial {
+				t.Fatalf("observable event was not preserved")
+			}
+		})
+	}
+}
+
+func TestBridgeReasoningRetryFailClosed(t *testing.T) {
+	cases := map[string]string{
+		"conflicting quota status": strings.Replace(bridgeFixtureError, `"type":"server_error"`, `"status":429,"type":"server_error"`, 1),
+		"other failure":            strings.Replace(bridgeFixtureError, "request_timeout", "other_error", 1),
+		"unterminated":             strings.TrimSuffix(bridgeFixtureError, "\n"),
+		"multiple data lines":      strings.Replace(bridgeFixtureError, "\n\n", "\ndata: {\"type\":\"other\"}\n\n", 1),
+		"conflicting event name":   "event: other\n" + bridgeFixtureError,
+	}
+	for name, tail := range cases {
+		t.Run(name, func(t *testing.T) {
+			initial := bridgeFixtureCreated + bridgeFixtureReasoning + tail
+			var out bytes.Buffer
+			attempts := 0
+			err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+				func(context.Context) (io.ReadCloser, error) { attempts++; return nil, nil }, func() bool { return true })
+			if err != nil || attempts != 0 || out.String() != initial {
+				t.Fatal("unrecognized or incomplete stream was not preserved")
+			}
+		})
+	}
+}
+
+func TestBridgeReasoningRetryAccountAndAttemptBound(t *testing.T) {
+	initial := bridgeFixtureCreated + bridgeFixtureReasoning + bridgeFixtureError
+	for _, sameAccount := range []bool{false, true} {
+		var out bytes.Buffer
+		attempts := 0
+		err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+			func(context.Context) (io.ReadCloser, error) {
+				attempts++
+				return io.NopCloser(strings.NewReader(initial)), nil
+			},
+			func() bool { return sameAccount })
+		want := 0
+		if sameAccount {
+			want = 1
+		}
+		if err != nil || attempts != want || out.String() != initial {
+			t.Fatal("account guard or retry bound failed")
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	var out bytes.Buffer
+	attempts := 0
+	err := bridgeReasoningRetryExperiment(ctx, &out, io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) { attempts++; return nil, nil }, func() bool { return true })
+	if !errors.Is(err, context.Canceled) || attempts != 0 {
+		t.Fatal("cancelled request retried")
+	}
+}
+
+func TestBridgeReasoningRetryPreservesSecondQuotaStream(t *testing.T) {
+	initial := bridgeFixtureCreated + bridgeFixtureReasoning + bridgeFixtureError
+	quota := "data: {\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"code\":\"rate_limit_exceeded\",\"status_code\":429}}\n\n"
+	var out bytes.Buffer
+	attempts := 0
+	err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) {
+			attempts++
+			return io.NopCloser(strings.NewReader(quota)), nil
+		},
+		func() bool { return true })
+	if err != nil || attempts != 1 || out.String() != quota {
+		t.Fatal("second-attempt quota stream was not preserved")
+	}
+}
+
+func TestBridgeReasoningRetryHTTPErrorPreservesStatus(t *testing.T) {
+	cases := []struct {
+		status   int
+		body     string
+		wantCode string
+		hidden   string
+	}{
+		{429, `{"error":{"type":"rate_limit_error","code":"usage_limit_reached","message":"synthetic"}}`, "usage_limit_reached", ""},
+		{401, `{"error":{"type":"authentication_error","code":"invalid_api_key"}}`, "invalid_api_key", ""},
+		{429, `malformed PRIVATE_SYNTHETIC`, "", "PRIVATE_SYNTHETIC"},
+	}
+	for _, tc := range cases {
+		response := &http.Response{StatusCode: tc.status, Body: io.NopCloser(strings.NewReader(tc.body))}
+		frame, err := io.ReadAll(bridgeReasoningRetryHTTPError(response))
+		if err != nil || !bytes.HasPrefix(frame, []byte("data: ")) {
+			t.Fatal("synthetic HTTP failure was not framed")
+		}
+		payload := bytes.TrimSpace(bytes.TrimPrefix(frame, []byte("data: ")))
+		if int(gjson.GetBytes(payload, "response.error.status_code").Int()) != tc.status ||
+			gjson.GetBytes(payload, "response.error.code").String() != tc.wantCode ||
+			(tc.hidden != "" && bytes.Contains(payload, []byte(tc.hidden))) {
+			t.Fatal("synthetic HTTP failure status or redaction was not preserved")
+		}
+	}
+}
+
+func TestBridgeReasoningRetryAccountCheckAloneCannotPinAccount(t *testing.T) {
+	// A passing test reproduces a safety gap: a switch can occur after a plain
+	// boolean check but before the new request selects its credential. It is
+	// therefore NOT evidence of production-safe account preservation.
+	initial := bridgeFixtureCreated + bridgeFixtureReasoning + bridgeFixtureError
+	selected, retriedWith := "synthetic-a", ""
+	var out bytes.Buffer
+	err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) {
+			retriedWith = selected
+			return io.NopCloser(strings.NewReader(bridgeFixtureSuccess)), nil
+		}, func() bool {
+			wasOriginal := selected == "synthetic-a"
+			selected = "synthetic-b" // the selection changes after the comparison
+			return wasOriginal
+		})
+	if err != nil || retriedWith != "synthetic-b" {
+		t.Fatal("the synthetic account-switch race was not reproduced")
+	}
+}
+
+func TestBridgeReasoningRetryLeavesFirstFailureWhenRetryCannotStart(t *testing.T) {
+	initial := bridgeFixtureCreated + bridgeFixtureReasoning + bridgeFixtureError
+	var out bytes.Buffer
+	attempts := 0
+	err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+		func(context.Context) (io.ReadCloser, error) {
+			attempts++
+			return nil, errors.New("synthetic network failure")
+		},
+		func() bool { return true })
+	if err != nil || attempts != 1 || out.String() != initial {
+		t.Fatal("original error was not preserved")
+	}
+}
+
+func TestBridgeReasoningRetryToolAllowlist(t *testing.T) {
+	cases := map[string]bool{
+		`{}`:           true,
+		`{"tools":[]}`: true,
+		`{"tools":[{"type":"function","name":"fixture"}]}`: true,
+		`{"tools":[],"tool_choice":"auto"}`:                true,
+		`{"tools":[],"tool_choice":{"type":"web_search"}}`: false,
+		`{"tools":[],"tool_choice":"unknown"}`:             false,
+		`{"tools":[{"type":"web_search"}]}`:                false,
+		`{"tools":[{"type":"mcp"}]}`:                       false,
+		`{"tools":[{"type":"computer"}]}`:                  false,
+		`{"tools":null}`:                                   false,
+		`{"tools":[{}]}`:                                   false,
+		`{broken`:                                          false,
+	}
+	for input, want := range cases {
+		if got := bridgeRetrySafeTools([]byte(input)); got != want {
+			t.Fatalf("tool allowlist mismatch for fixture")
+		}
+	}
+}
+
+func TestBridgeReasoningRetryReleasesOnSizeBound(t *testing.T) {
+	large := "data: {\"type\":\"response.output_item.done\",\"item\":{\"type\":\"reasoning\",\"summary\":[],\"encrypted_content\":\"" + strings.Repeat("A", bridgeReasoningLineLimit) + "\"}}\n\n"
+	cases := map[string]string{
+		"line":  bridgeFixtureCreated + large + bridgeFixtureError,
+		"total": bridgeFixtureCreated + strings.Repeat(bridgeFixtureReasoning, bridgeReasoningBufferLimit/len(bridgeFixtureReasoning)+2) + bridgeFixtureError,
+	}
+	for name, initial := range cases {
+		t.Run(name, func(t *testing.T) {
+			var out bytes.Buffer
+			attempts := 0
+			err := bridgeReasoningRetryExperiment(context.Background(), &out, io.NopCloser(strings.NewReader(initial)),
+				func(context.Context) (io.ReadCloser, error) { attempts++; return nil, nil }, func() bool { return true })
+			if err != nil || attempts != 0 || out.String() != initial {
+				t.Fatal("bounded stream was not preserved")
+			}
+		})
+	}
+}
+
+func TestBridgeReasoningRetryCancellationClosesBlockedReader(t *testing.T) {
+	reader, writer := io.Pipe()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	defer writer.Close()
+	result := make(chan error, 1)
+	attempts := 0
+	go func() {
+		result <- bridgeReasoningRetryExperiment(ctx, io.Discard, reader,
+			func(context.Context) (io.ReadCloser, error) { attempts++; return nil, nil }, func() bool { return true })
+	}()
+	cancel()
+	select {
+	case err := <-result:
+		if !errors.Is(err, context.Canceled) || attempts != 0 {
+			t.Fatal("blocked stream cancellation failed")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("blocked upstream reader was not closed")
+	}
+}
+
+func TestBridgeReasoningRetryHTTPPreservesSyntheticRequest(t *testing.T) {
+	var mu sync.Mutex
+	var bodies []string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error("fixture request read failed")
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer synthetic-fixture" {
+			t.Error("fixture authorization changed")
+		}
+		mu.Lock()
+		bodies = append(bodies, string(body))
+		attempt := len(bodies)
+		mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		if attempt == 1 {
+			_, _ = io.WriteString(w, bridgeFixtureCreated+bridgeFixtureReasoning+bridgeFixtureError)
+			return
+		}
+		_, _ = io.WriteString(w, bridgeFixtureSuccess)
+	}))
+	defer server.Close()
+	payload := `{"model":"gpt-fixture","reasoning":{"effort":"xhigh"},"prompt_cache_key":"synthetic-session","tools":[{"type":"function","name":"fixture"}],"input":[{"role":"user","content":"synthetic"}]}`
+	request, err := http.NewRequestWithContext(context.Background(), http.MethodPost, server.URL, strings.NewReader(payload))
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Header.Set("Authorization", "Bearer synthetic-fixture")
+	first, err := server.Client().Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out bytes.Buffer
