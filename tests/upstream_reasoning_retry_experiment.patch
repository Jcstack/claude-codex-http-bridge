+func TestBridgeReasoningRetryHTTPPreservesSyntheticRequest(t *testing.T) {
+	var mu sync.Mutex
+	var bodies []string
+	selected := "synthetic-account-a"
+	selectedDuringRetry := ""
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error("fixture request read failed")
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer synthetic-fixture" {
+			t.Error("fixture authorization changed")
+		}
+		if r.Header.Get("Chatgpt-Account-Id") != "synthetic-account-a" {
+			t.Error("fixture account binding changed")
+		}
+		mu.Lock()
+		bodies = append(bodies, string(body))
+		attempt := len(bodies)
+		if attempt == 1 {
+			selected = "synthetic-account-b"
+		} else {
+			selectedDuringRetry = selected
+		}
+		mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		if attempt == 1 {
+			_, _ = io.WriteString(w, bridgeFixtureCreated+bridgeFixtureReasoning+bridgeFixtureError)
+			return
+		}
+		_, _ = io.WriteString(w, bridgeFixtureSuccess)
+	}))
+	defer server.Close()
+	payload := `{"model":"gpt-fixture","reasoning":{"effort":"xhigh"},"prompt_cache_key":"synthetic-session","tools":[{"type":"function","name":"fixture"}],"input":[{"role":"user","content":"synthetic"}]}`
+	request, err := http.NewRequestWithContext(context.Background(), http.MethodPost, server.URL, strings.NewReader(payload))
+	if err != nil {
+		t.Fatal(err)
+	}
+	request.Header.Set("Authorization", "Bearer synthetic-fixture")
+	request.Header.Set("Chatgpt-Account-Id", "synthetic-account-a")
+	first, err := server.Client().Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out bytes.Buffer
+	err = bridgeReasoningRetryExperiment(request.Context(), &out, first.Body, func(ctx context.Context) (io.ReadCloser, error) {
+		again := request.Clone(ctx)
+		again.Body, err = request.GetBody()
+		if err != nil {
+			return nil, err
+		}
+		response, requestErr := server.Client().Do(again)
+		if requestErr != nil {
+			return nil, requestErr
+		}
+		return response.Body, nil
+	}, func() bool { return true })
+	mu.Lock()
+	defer mu.Unlock()
+	if err != nil || out.String() != bridgeFixtureSuccess || len(bodies) != 2 || bodies[0] != payload || bodies[1] != payload || selectedDuringRetry != "synthetic-account-b" {
+		t.Fatal("synthetic HTTP replay did not preserve the request and response boundary")
+	}
+}
