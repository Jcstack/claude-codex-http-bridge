+++ b/internal/runtime/executor/codex_bridge_reasoning_retry_experiment.go
@@ -0,0 +1,413 @@
+package executor
+
+// This isolated experiment is not wired into production. It tests a narrow
+// pre-delivery recovery boundary without retaining request or response data.
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const bridgeReasoningBufferLimit = 2 << 20
+const bridgeReasoningLineLimit = 64 << 10
+const bridgeReasoningRequestLimit = 16 << 20
+
+// Reject duplicate JSON object keys and deeply nested frames. Distinct JSON
+// readers can disagree on duplicate keys, including tool type and error code.
+func bridgeReasoningJSONSafe(data []byte) bool {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	var value func(int) bool
+	value = func(depth int) bool {
+		if depth > 64 {
+			return false
+		}
+		token, err := decoder.Token()
+		if err != nil {
+			return false
+		}
+		delim, isDelim := token.(json.Delim)
+		if !isDelim {
+			return true
+		}
+		switch delim {
+		case '{':
+			seen := make(map[string]struct{})
+			for decoder.More() {
+				keyToken, keyErr := decoder.Token()
+				key, ok := keyToken.(string)
+				if keyErr != nil || !ok {
+					return false
+				}
+				if _, duplicate := seen[key]; duplicate {
+					return false
+				}
+				seen[key] = struct{}{}
+				if !value(depth + 1) {
+					return false
+				}
+			}
+		case '[':
+			for decoder.More() {
+				if !value(depth + 1) {
+					return false
+				}
+			}
+		default:
+			return false
+		}
+		end, endErr := decoder.Token()
+		return endErr == nil && ((delim == '{' && end == json.Delim('}')) || (delim == '[' && end == json.Delim(']')))
+	}
+	if !value(0) {
+		return false
+	}
+	_, err := decoder.Token()
+	return errors.Is(err, io.EOF)
+}
+
+// Only the exact structured capacity code seen in the disposable fixture is
+// considered. Conflicting or malformed explicit statuses must fail closed.
+func bridgeReasoningOverloadBody(body []byte) bool {
+	if gjson.GetBytes(body, "error.type").String() != "service_unavailable_error" ||
+		gjson.GetBytes(body, "error.code").String() != "server_is_overloaded" {
+		return false
+	}
+	for _, key := range []string{"error.status", "error.status_code"} {
+		status := gjson.GetBytes(body, key)
+		if status.Exists() && (status.Type != gjson.Number || status.Num != float64(http.StatusServiceUnavailable)) {
+			return false
+		}
+	}
+	return true
+}
+
+// The normalizer extracts an error object and can discard outer status fields.
+// Reject conflicting or malformed explicit outer statuses before replay.
+func bridgeReasoningOuterStatusAllows(data []byte, first, second int) bool {
+	for _, key := range []string{"status", "status_code", "response.status_code"} {
+		status := gjson.GetBytes(data, key)
+		if status.Exists() && (status.Type != gjson.Number || (status.Num != float64(first) && status.Num != float64(second))) {
+			return false
+		}
+	}
+	return true
+}
+
+func bridgeReasoningOverloadLine(line []byte) bool {
+	trimmed := bytes.TrimSpace(line)
+	if !bytes.HasPrefix(trimmed, []byte("data:")) {
+		return false
+	}
+	data := bytes.TrimSpace(trimmed[len("data:"):])
+	if !gjson.ValidBytes(data) || !bridgeReasoningJSONSafe(data) {
+		return false
+	}
+	body, ok := codexTerminalFailureBody(data)
+	return ok && bridgeReasoningOverloadBody(body) && bridgeReasoningOuterStatusAllows(data, http.StatusServiceUnavailable, http.StatusServiceUnavailable)
+}
+
+// An isolated experimental policy, not the currently installed service. Wait
+// 30-60 seconds with positive jitter; cancellation must stop the wait. On a
+// random-source failure wait the full minute rather than retrying immediately.
+func bridgeReasoningOverloadWait(ctx context.Context) error {
+	delay := 60 * time.Second
+	var sample [8]byte
+	if _, err := rand.Read(sample[:]); err == nil {
+		delay = 30*time.Second + time.Duration(binary.BigEndian.Uint64(sample[:])%uint64(30*time.Second+1))
+	}
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+// bridgeReasoningRetryHTTPError is an experimental in-band representation of
+// a retry's HTTP failure. No headers or raw response are written to logs. A
+// bounded, valid error object is retained; otherwise a fixed message carries
+// the authoritative HTTP status. Header fidelity remains a deployment gate.
+func bridgeReasoningRetryHTTPError(response *http.Response) io.ReadCloser {
+	raw, err := io.ReadAll(io.LimitReader(response.Body, (1<<20)+1))
+	_ = response.Body.Close()
+	result := []byte(`{"type":"response.failed","response":{"status":"failed","error":{"type":"api_error","message":"Retry request returned an HTTP error"}}}`)
+	if err == nil && len(raw) <= 1<<20 && gjson.ValidBytes(raw) {
+		value := gjson.GetBytes(raw, "error")
+		if value.IsObject() {
+			result, _ = sjson.SetRawBytes(result, "response.error", []byte(value.Raw))
+		}
+	}
+	result, _ = sjson.SetBytes(result, "response.error.status_code", response.StatusCode)
+	frame := append([]byte("data: "), result...)
+	frame = append(frame, '\n', '\n')
+	return io.NopCloser(bytes.NewReader(frame))
+}
+
+func bridgeRetrySafeTools(body []byte) bool {
+	if len(body) > bridgeReasoningRequestLimit || !gjson.ValidBytes(body) || !bridgeReasoningJSONSafe(body) {
+		return false
+	}
+	if !gjson.ParseBytes(body).IsObject() {
+		return false
+	}
+	for _, key := range []string{"background", "store"} {
+		option := gjson.GetBytes(body, key)
+		if option.Exists() && option.Type != gjson.False {
+			return false
+		}
+	}
+	choice := gjson.GetBytes(body, "tool_choice")
+	if choice.Exists() {
+		if choice.Type == gjson.String {
+			if choice.String() != "auto" && choice.String() != "none" && choice.String() != "required" {
+				return false
+			}
+		} else if !choice.IsObject() || choice.Get("type").String() != "function" {
+			return false
+		}
+	}
+	tools := gjson.GetBytes(body, "tools")
+	if !tools.Exists() {
+		return true
+	}
+	if !tools.IsArray() {
+		return false
+	}
+	for _, tool := range tools.Array() {
+		if !tool.IsObject() || tool.Get("type").String() != "function" {
+			return false
+		}
+	}
+	return true
+}
+
+// bridgeReasoningLine returns safe, terminalRetry. Unknown or potentially
+// substantive events force immediate pass-through; they are never replayed.
+func bridgeReasoningLine(line []byte) (bool, bool) {
+	trimmed := bytes.TrimSpace(line)
+	if len(trimmed) == 0 || bytes.HasPrefix(trimmed, []byte(":")) || bytes.HasPrefix(trimmed, []byte("event:")) {
+		return true, false
+	}
+	if !bytes.HasPrefix(trimmed, []byte("data:")) {
+		return false, false
+	}
+	data := bytes.TrimSpace(trimmed[len("data:"):])
+	if !gjson.ValidBytes(data) || !bridgeReasoningJSONSafe(data) {
+		return false, false
+	}
+	typ := gjson.GetBytes(data, "type").String()
+	if typ == "error" || typ == "response.failed" {
+		body, ok := codexTerminalFailureBody(data)
+		if !ok {
+			return false, false
+		}
+		if bridgeReasoningOverloadBody(body) && bridgeReasoningOuterStatusAllows(data, http.StatusServiceUnavailable, http.StatusServiceUnavailable) {
+			return false, true
+		}
+		status := codexTerminalFailureStatus(body)
+		return false, (status == 408 || status == 502) &&
+			bridgeReasoningOuterStatusAllows(data, 408, 502) &&
+			gjson.GetBytes(body, "error.type").String() == "server_error" &&
+			gjson.GetBytes(body, "error.code").String() == "request_timeout" &&
+			gjson.GetBytes(body, "error.message").String() == codexIncompleteStreamMessage
+	}
+	switch typ {
+	case "response.created", "response.in_progress":
+		if !gjson.GetBytes(data, "response").IsObject() {
+			return false, false
+		}
+		status := gjson.GetBytes(data, "response.status")
+		if status.Exists() && status.String() != "queued" && status.String() != "in_progress" {
+			return false, false
+		}
+		for _, key := range []string{"response.error", "response.incomplete_details"} {
+			value := gjson.GetBytes(data, key)
+			if value.Exists() && value.Type != gjson.Null {
+				return false, false
+			}
+		}
+		output := gjson.GetBytes(data, "response.output")
+		return !output.Exists() || (output.IsArray() && len(output.Array()) == 0), false
+	case "response.output_item.added", "response.output_item.done":
+		item := gjson.GetBytes(data, "item")
+		if item.Get("type").String() != "reasoning" {
+			return false, false
+		}
+		for _, name := range []string{"summary", "content"} {
+			v := item.Get(name)
+			if v.Exists() && (!v.IsArray() || len(v.Array()) != 0) {
+				return false, false
+			}
+		}
+		return true, false
+	case "keepalive":
+		return true, false
+	default:
+		return false, false
+	}
+}
+
+// bridgeReasoningRetryExperiment sends no initial response bytes until it is
+// sure they cannot be discarded. Retry is bounded to one, and the caller owns
+// account-identity validation and downstream keepalives. This function does
+// not establish safe behavior for unlisted provider-side tools or account
+// changes, and deliberately is not connected to an installed runtime.
+func bridgeReasoningRetryExperiment(ctx context.Context, dst io.Writer, first io.ReadCloser,
+	retry func(context.Context) (io.ReadCloser, error), sameAccount func() bool) error {
+	return bridgeReasoningRetryExperimentWithWait(ctx, dst, first, retry, sameAccount, bridgeReasoningOverloadWait)
+}
+
+func bridgeReasoningRetryExperimentWithWait(ctx context.Context, dst io.Writer, first io.ReadCloser,
+	retry func(context.Context) (io.ReadCloser, error), sameAccount func() bool,
+	overloadWait func(context.Context) error) error {
+	current := first
+	var currentMu sync.Mutex
+	done := make(chan struct{})
+	go func() {
+		select {
+		case <-ctx.Done():
+			currentMu.Lock()
+			body := current
+			currentMu.Unlock()
+			_ = body.Close()
+		case <-done:
+		}
+	}()
+	defer func() {
+		close(done)
+		currentMu.Lock()
+		body := current
+		currentMu.Unlock()
+		_ = body.Close()
+	}()
+	attempts := 0
+	for {
+		reader := bufio.NewReaderSize(current, bridgeReasoningLineLimit)
+		var held bytes.Buffer
+		var event bytes.Buffer
+		var dataLine []byte
+		dataCount := 0
+		eventName := ""
+		invalidField := false
+		for {
+			line, err := reader.ReadSlice('\n')
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+			if errors.Is(err, bufio.ErrBufferFull) || held.Len()+event.Len()+len(line) > bridgeReasoningBufferLimit {
+				if _, e := dst.Write(held.Bytes()); e != nil {
+					return e
+				}
+				if _, e := dst.Write(event.Bytes()); e != nil {
+					return e
+				}
+				if _, e := dst.Write(line); e != nil {
+					return e
+				}
+				_, e := io.Copy(dst, reader)
+				return e
+			}
+			event.Write(line)
+			trimmed := bytes.TrimSpace(line)
+			if len(trimmed) != 0 {
+				switch {
+				case bytes.HasPrefix(trimmed, []byte(":")):
+				case bytes.HasPrefix(trimmed, []byte("data:")):
+					dataCount++
+					dataLine = bytes.Clone(line)
+				case bytes.HasPrefix(trimmed, []byte("event:")) && eventName == "":
+					eventName = strings.TrimSpace(string(trimmed[len("event:"):]))
+				default:
+					invalidField = true
+				}
+			} else if len(line) > 0 {
+				safe, terminalRetry := true, false
+				if invalidField || dataCount > 1 || (dataCount == 0 && eventName != "") {
+					safe = false
+				} else if dataCount == 1 {
+					safe, terminalRetry = bridgeReasoningLine(dataLine)
+					if eventName != "" {
+						data := bytes.TrimSpace(bytes.TrimSpace(dataLine)[len("data:"):])
+						if eventName != gjson.GetBytes(data, "type").String() {
+							safe, terminalRetry = false, false
+						}
+					}
+				}
+				if !safe {
+					if terminalRetry && attempts == 0 && ctx.Err() == nil && sameAccount() {
+						proceed := true
+						if bridgeReasoningOverloadLine(dataLine) {
+							if err := overloadWait(ctx); err != nil {
+								return err
+							}
+							if ctx.Err() != nil {
+								return ctx.Err()
+							}
+							// A check after waiting narrows, but does not eliminate, the
+							// race before the caller actually starts a new request.
+							proceed = sameAccount()
+						}
+						if proceed {
+							next, nextErr := retry(ctx)
+							if nextErr == nil && next != nil {
+								currentMu.Lock()
+								if ctx.Err() != nil {
+									currentMu.Unlock()
+									_ = next.Close()
+									return ctx.Err()
+								}
+								old := current
+								current = next
+								currentMu.Unlock()
+								_ = old.Close()
+								attempts++
+								break
+							}
+						}
+					}
+					if _, e := dst.Write(held.Bytes()); e != nil {
+						return e
+					}
+					if _, e := dst.Write(event.Bytes()); e != nil {
+						return e
+					}
+					_, e := io.Copy(dst, reader)
+					return e
+				}
+				held.Write(event.Bytes())
+				event.Reset()
+				dataLine, dataCount, eventName, invalidField = nil, 0, "", false
+			}
+			if err != nil {
+				if _, e := dst.Write(held.Bytes()); e != nil {
+					return e
+				}
+				if _, e := dst.Write(event.Bytes()); e != nil {
+					return e
+				}
+				if errors.Is(err, io.EOF) {
+					return nil
+				}
+				return err
+			}
+			if ctx.Err() != nil {
+				return ctx.Err()
+			}
+		}
+	}
+}
