+func TestBridgeReasoningRetryExecutorUsesOriginalOAuthSnapshot(t *testing.T) {
+	t.Setenv("BRIDGE_SYNTHETIC_REASONING_RETRY", "1")
+	type attempt struct{ token, account, body string }
+	attempts := make(chan attempt, 8)
+	firstStarted := make(chan struct{})
+	release := make(chan struct{})
+	var releaseOnce sync.Once
+	var calls atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			t.Error("could not read synthetic request")
+			return
+		}
+		n := calls.Add(1)
+		attempts <- attempt{r.Header.Get("Authorization"), r.Header.Get("Chatgpt-Account-Id"), string(body)}
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.WriteHeader(http.StatusOK)
+		w.(http.Flusher).Flush()
+		if n == 1 {
+			close(firstStarted)
+			<-release
+			_, _ = io.WriteString(w, bridgeFixtureCreated+bridgeFixtureReasoning+bridgeFixtureError)
+			return
+		}
+		_, _ = io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"synthetic\",\"object\":\"response\",\"status\":\"completed\",\"model\":\"gpt-6.1-sol\",\"output\":[],\"usage\":{\"input_tokens\":1,\"output_tokens\":1}}}\n\n")
+	}))
+	defer func() { releaseOnce.Do(func() { close(release) }); server.Close() }()
+	cfg := &config.Config{}
+	cfg.DisableImageGeneration = config.DisableImageGenerationPassthrough
+	executor := NewCodexExecutor(cfg)
+	makeAuth := func(token, account string) *cliproxyauth.Auth {
+		return &cliproxyauth.Auth{Provider: "codex", Attributes: map[string]string{"base_url": server.URL},
+			Metadata: map[string]any{"type": "codex", "access_token": token, "account_id": account}}
+	}
+	selectedA := makeAuth("synthetic-token-a", "synthetic-account-a")
+	selectedB := makeAuth("synthetic-token-b", "synthetic-account-b")
+	req := cliproxyexecutor.Request{Model: "gpt-6.1-sol", Payload: []byte(`{"model":"gpt-6.1-sol","input":"synthetic","reasoning":{"effort":"xhigh"}}`)}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, Stream: true}
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	first, err := executor.ExecuteStream(ctx, selectedA.Clone(), req, opts)
+	if err != nil {
+		t.Fatalf("first synthetic executor request failed: %v", err)
+	}
+	<-firstStarted
+	// The manager chooses B for future work while the first request retains A.
+	selected := selectedB.Clone()
+	releaseOnce.Do(func() { close(release) })
+	for chunk := range first.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("synthetic retry stream failed: %v", chunk.Err)
+		}
+	}
+	second, err := executor.ExecuteStream(ctx, selected, req, opts)
+	if err != nil {
+		t.Fatalf("subsequent synthetic executor request failed: %v", err)
+	}
+	for chunk := range second.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("subsequent synthetic stream failed: %v", chunk.Err)
+		}
+	}
+	if len(attempts) != 3 {
+		t.Fatalf("expected three synthetic upstream attempts, got %d", len(attempts))
+	}
+	firstAttempt, retryAttempt, nextAttempt := <-attempts, <-attempts, <-attempts
+	if firstAttempt.token != "Bearer synthetic-token-a" || retryAttempt.token != firstAttempt.token ||
+		firstAttempt.account != "synthetic-account-a" || retryAttempt.account != firstAttempt.account ||
+		firstAttempt.body != retryAttempt.body || nextAttempt.token != "Bearer synthetic-token-b" ||
+		nextAttempt.account != "synthetic-account-b" {
+		t.Fatal("OAuth-shaped credential snapshot or request changed")
+	}
+}
