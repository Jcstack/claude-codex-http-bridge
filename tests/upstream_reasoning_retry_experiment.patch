+func TestBridgeReasoningRetryHTTPErrorPreservesStatus(t *testing.T) {
+	cases := []struct {
+		status   int
+		body     string
+		wantCode string
+		hidden   string
+	}{
+		{429, `{"error":{"type":"rate_limit_error","code":"usage_limit_reached","message":"synthetic"}}`, "usage_limit_reached", ""},
+		{401, `{"error":{"type":"authentication_error","code":"invalid_api_key"}}`, "invalid_api_key", ""},
+		{429, `malformed PRIVATE_SYNTHETIC`, "", "PRIVATE_SYNTHETIC"},
+	}
+	for _, tc := range cases {
+		response := &http.Response{StatusCode: tc.status, Body: io.NopCloser(strings.NewReader(tc.body))}
+		frame, err := io.ReadAll(bridgeReasoningRetryHTTPError(response))
+		if err != nil || !bytes.HasPrefix(frame, []byte("data: ")) {
+			t.Fatal("synthetic HTTP failure was not framed")
+		}
+		payload := bytes.TrimSpace(bytes.TrimPrefix(frame, []byte("data: ")))
+		if int(gjson.GetBytes(payload, "response.error.status_code").Int()) != tc.status ||
+			gjson.GetBytes(payload, "response.error.code").String() != tc.wantCode ||
+			(tc.hidden != "" && bytes.Contains(payload, []byte(tc.hidden))) {
+			t.Fatal("synthetic HTTP failure status or redaction was not preserved")
+		}
+	}
+}
