diff --git a/sdk/api/handlers/claude_turn_scoped_system.go b/sdk/api/handlers/claude_turn_scoped_system.go
new file mode 100644
index 0000000..dbcde80
--- /dev/null
+++ b/sdk/api/handlers/claude_turn_scoped_system.go
@@ -0,0 +1,73 @@
+package handlers
+
+import (
+	"errors"
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+// ValidateClaudeTurnScopedSystem refuses unsupported combinations instead of
+// silently discarding a tool operation, reasoning setting, or cache control.
+// Consecutive system messages are validated as one group for placement.
+func ValidateClaudeTurnScopedSystem(raw []byte) error {
+	messages := gjson.GetBytes(raw, "messages")
+	if !messages.IsArray() {
+		return nil
+	}
+	items := messages.Array()
+	for index, message := range items {
+		scope := message.Get("clear_at")
+		if !scope.Exists() || scope.Type == gjson.Null {
+			continue
+		}
+		if message.Get("role").String() != "system" || scope.Type != gjson.String ||
+			(scope.String() != "never" && scope.String() != "next_user_message") {
+			return errors.New("invalid turn-scoped system message")
+		}
+		if scope.String() != "next_user_message" {
+			continue
+		}
+		start, end := index, index+1
+		for start > 0 && items[start-1].Get("role").String() == "system" {
+			start--
+		}
+		for end < len(items) && items[end].Get("role").String() == "system" {
+			end++
+		}
+		if start == 0 || (items[start-1].Get("role").String() != "user" && !bridgeAssistantServerResult(items[start-1])) ||
+			(end < len(items) && items[end].Get("role").String() != "assistant") {
+			return errors.New("invalid turn-scoped system message placement")
+		}
+		output := message.Get("output_config")
+		if output.Exists() && output.Type != gjson.Null {
+			return errors.New("turn-scoped system message cannot carry output configuration")
+		}
+		content := message.Get("content")
+		if content.Type == gjson.String {
+			continue
+		}
+		if !content.IsArray() || len(content.Array()) == 0 {
+			return errors.New("turn-scoped system message requires text")
+		}
+		for _, block := range content.Array() {
+			cache := block.Get("cache_control")
+			if block.Get("type").String() != "text" || (cache.Exists() && cache.Type != gjson.Null) {
+				return errors.New("turn-scoped system message must contain only uncached text")
+			}
+		}
+	}
+	return nil
+}
+
+func bridgeAssistantServerResult(message gjson.Result) bool {
+	content := message.Get("content")
+	if message.Get("role").String() != "assistant" || !content.IsArray() {
+		return false
+	}
+	blocks := content.Array()
+	if len(blocks) == 0 {
+		return false
+	}
+	return strings.HasSuffix(blocks[len(blocks)-1].Get("type").String(), "_tool_result")
+}
