+
+// OpenAI server error names are not Claude Messages error discriminators.
+// Keep the status-derived Claude category so the caller can apply its own
+// retry policy. Future unknown types and genuine Claude categories stay intact.
+func claudeCompatibleUpstreamErrorType(status int, upstreamType string) string {
+	switch upstreamType {
+	case "server_error", "service_unavailable_error":
+		return claudeErrorTypeFromStatus(status)
+	default:
+		return upstreamType
+	}
+}
