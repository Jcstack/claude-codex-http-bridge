+
+func TestBridgeClaudeForeignServerErrorUsesNativeCategory(t *testing.T) {
+	for _, tc := range []struct {
+		status        int
+		foreign, want string
+	}{
+		{408, "server_error", "timeout_error"},
+		{502, "server_error", "api_error"},
+		{503, "service_unavailable_error", "api_error"},
+		{429, "server_error", "rate_limit_error"},
+		{401, "server_error", "authentication_error"},
+		{403, "permission_error", "permission_error"},
+		{529, "overloaded_error", "overloaded_error"},
+		{500, "future_error", "future_error"},
+	} {
+		for _, nested := range []bool{false, true} {
+			var body string
+			if nested {
+				body = `{"error":{"type":"` + tc.foreign + `","message":"synthetic diagnostic"}}`
+			} else {
+				body = `{"type":"` + tc.foreign + `","message":"synthetic diagnostic"}`
+			}
+			got, message := claudeErrorDetailFromText(tc.status, body)
+			if got != tc.want || message != "synthetic diagnostic" {
+				t.Fatal("foreign error mapping changed its native category or message")
+			}
+		}
+	}
+}
