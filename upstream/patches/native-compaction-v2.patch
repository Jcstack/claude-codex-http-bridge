+	auth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	ex "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	tr "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexBridgeNativeCompactUsesV2WithoutLoweringNormalEffort(t *testing.T) {
+	requests := make(chan []byte, 3)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		requests <- b
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_fixture\",\"status\":\"completed\",\"model\":\"gpt-6.1-sol\",\"output\":[{\"type\":\"compaction\",\"encrypted_content\":\"synthetic-capsule\"}],\"usage\":{\"input_tokens\":100,\"output_tokens\":10}}}\n\n")
+	}))
+	defer server.Close()
+	e := NewCodexExecutor(&config.Config{})
+	a := &auth.Auth{Provider: "codex", Attributes: map[string]string{"base_url": server.URL, "api_key": strings.Repeat("k", 64)}}
+	raw := []byte(`{"model":"gpt-6.1-sol","max_tokens":1000,"output_config":{"effort":"max"},"messages":[{"role":"user","content":"Retain the marker."}]}`)
+	opts := ex.Options{SourceFormat: tr.FormatClaude, OriginalRequest: raw, Headers: http.Header{helps.BridgeCompactHeader: []string{"1"}, "X-Claude-Code-Request-Class": []string{"compaction"}}}
+	response, err := e.Execute(context.Background(), a, ex.Request{Model: "gpt-6.1-sol", Payload: raw}, opts)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(response.Payload), "codex-native-context-v1:") {
+		t.Fatal("native context was not returned through the text boundary")
+	}
+	request := <-requests
+	if gjson.GetBytes(request, "reasoning.effort").Exists() {
+		t.Fatal("main effort leaked into a native maintenance operation")
+	}
+	items := gjson.GetBytes(request, "input").Array()
+	if len(items) == 0 || items[len(items)-1].Get("type").String() != "compaction_trigger" {
+		t.Fatal("V2 trigger was absent")
+	}
+	opts.Headers.Del(helps.BridgeCompactHeader)
+	_, _ = e.Execute(context.Background(), a, ex.Request{Model: "gpt-6.1-sol", Payload: raw}, opts)
+	if gjson.GetBytes(<-requests, "reasoning.effort").String() != "max" {
+		t.Fatal("normal compaction effort was changed")
+	}
+}
+
+func TestCodexBridgeCompactFinalPayloadRulesWinOnce(t *testing.T) {
+	for _, compact := range []bool{false, true} {
+		for _, stream := range []bool{false, true} {
+			t.Run(fmt.Sprintf("compact=%v/stream=%v", compact, stream), func(t *testing.T) {
+				bodies := make(chan []byte, 1)
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					body, _ := io.ReadAll(r.Body)
+					bodies <- body
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = io.WriteString(w, "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"resp_fixture\",\"status\":\"completed\",\"output\":[{\"type\":\"compaction\",\"encrypted_content\":\"fixture\"}]}}\n\n")
+				}))
+				defer server.Close()
+				models := []config.PayloadModelRule{{Name: "*", Protocol: "codex", FromProtocol: "claude"}}
+				e := NewCodexExecutor(&config.Config{Payload: config.PayloadConfig{
+					Override: []config.PayloadRule{{Models: models, Params: map[string]any{"audit.-1": "once", "instructions": "operator instructions"}}},
+					Filter:   []config.PayloadFilterRule{{Models: models, Params: []string{"input.0", "reasoning", "store"}}},
+				}})
+				key := strings.Repeat("k", 64)
+				a := &auth.Auth{Provider: "codex", Attributes: map[string]string{"base_url": server.URL, "api_key": key}}
+				summary, _ := helps.BridgeCompactSummary([]byte(`[{"type":"compaction","encrypted_content":"previous"}]`), "gpt-6.1-sol", key)
+				raw, _ := json.Marshal(map[string]any{"model": "gpt-6.1-sol", "max_tokens": 1000,
+					"messages":      []any{map[string]any{"role": "user", "content": summary}, map[string]any{"role": "user", "content": "new turn"}},
+					"output_config": map[string]any{"effort": "max"}})
+				opts := ex.Options{SourceFormat: tr.FormatClaude, OriginalRequest: raw, Stream: stream, Headers: make(http.Header)}
+				if compact {
+					opts.Headers.Set(helps.BridgeCompactHeader, "1")
+					opts.Headers.Set("X-Claude-Code-Request-Class", "compaction")
+				}
+				if stream {
+					result, err := e.ExecuteStream(t.Context(), a, ex.Request{Model: "gpt-6.1-sol", Payload: raw}, opts)
+					if err != nil {
+						t.Fatal(err)
+					}
+					for chunk := range result.Chunks {
+						if chunk.Err != nil {
+							t.Fatal(chunk.Err)
+						}
+					}
+				} else if _, err := e.Execute(t.Context(), a, ex.Request{Model: "gpt-6.1-sol", Payload: raw}, opts); err != nil {
+					t.Fatal(err)
+				}
+				body := <-bodies
+				if gjson.GetBytes(body, "audit").Raw != `["once"]` || gjson.GetBytes(body, "instructions").String() != "operator instructions" {
+					t.Fatal("original source rules did not apply exactly once")
+				}
+				if gjson.GetBytes(body, "reasoning").Exists() || gjson.GetBytes(body, "store").Exists() || strings.Contains(string(body), `"type":"compaction"`) {
+					t.Fatal("built-in replay or defaults undid the final filter")
+				}
+			})
+		}
+	}
+}
+
+func TestCodexBridgeCompactCountRejectsForeignCapsules(t *testing.T) {
+	key := strings.Repeat("k", 64)
+	summary, _ := helps.BridgeCompactSummary([]byte(`[{"type":"compaction","encrypted_content":"fixture"}]`), "gpt-6.1-sol", key)
+	raw, _ := json.Marshal(map[string]any{"model": "gpt-6.1-sol", "messages": []any{map[string]any{"role": "user", "content": summary}}})
+	e := NewCodexExecutor(&config.Config{})
+	a := &auth.Auth{Provider: "codex", Attributes: map[string]string{"base_url": "http://127.0.0.1:1/v1", "api_key": "foreign-key"}}
+	_, err := e.CountTokens(t.Context(), a, ex.Request{Model: "gpt-6.1-sol", Payload: raw}, ex.Options{SourceFormat: tr.FormatClaude})
+	if err == nil {
+		t.Fatal("token count accepted a foreign context capsule")
+	}
+}
