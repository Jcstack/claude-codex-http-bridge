diff --git a/internal/runtime/executor/helps/bridge_compaction.go b/internal/runtime/executor/helps/bridge_compaction.go
new file mode 100644
index 0000000..d99201c
--- /dev/null
+++ b/internal/runtime/executor/helps/bridge_compaction.go
@@ -0,0 +1,189 @@
+package helps
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const BridgeCompactHeader = "X-Codex-Bridge-Native-Compaction"
+const bridgeCompactPrefix = "<!-- codex-native-context-v1:"
+const bridgeCompactSuffix = " -->"
+const bridgeCompactLead = "Context snapshot retained. Continue the existing task using the preserved conversation state."
+const bridgeCompactLimit = 1 << 20
+
+type bridgeCompactFinalizerKey struct{}
+
+// WithBridgeCompactFinalizer retains the original Claude rule-matching context
+// when the internal maintenance request uses the native wire representation.
+func WithBridgeCompactFinalizer(ctx context.Context, finalize PayloadFinalizer) context.Context {
+	return context.WithValue(ctx, bridgeCompactFinalizerKey{}, finalize)
+}
+
+func BridgeCompactFinalizer(ctx context.Context, otherwise PayloadFinalizer) PayloadFinalizer {
+	if finalize, ok := ctx.Value(bridgeCompactFinalizerKey{}).(PayloadFinalizer); ok && finalize != nil {
+		return finalize
+	}
+	return otherwise
+}
+
+// BridgeCompactLocal restricts this extension to a guarded local inference hop.
+// The local upstream key is stable across model/account/backend changes and is
+// never a rotating OAuth token or a public API project key.
+func BridgeCompactLocal(baseURL, key string) bool {
+	u, err := url.Parse(baseURL)
+	if err != nil || key == "" || (u.Scheme != "http" && u.Scheme != "https") {
+		return false
+	}
+	ip := net.ParseIP(u.Hostname())
+	return ip != nil && ip.IsLoopback()
+}
+
+func bridgeCompactMAC(raw []byte, key string) []byte {
+	h := hmac.New(sha256.New, []byte(key))
+	_, _ = h.Write([]byte("claude-codex-native-context-v1\x00"))
+	_, _ = h.Write(raw)
+	return h.Sum(nil)
+}
+
+func validBridgeCompactItems(items gjson.Result) bool {
+	rows := items.Array()
+	return items.IsArray() && len(rows) == 1 && rows[0].Get("type").String() == "compaction" &&
+		rows[0].Get("encrypted_content").Type == gjson.String && rows[0].Get("encrypted_content").String() != ""
+}
+
+// BridgeCompactSummary is self-contained. It survives Claude's text-only
+// /compact boundary and a later process/backend restart without a state table.
+// Authentication prevents page/tool text from inventing a privileged capsule.
+func BridgeCompactSummary(items []byte, model, key string) (string, error) {
+	if len(items) > bridgeCompactLimit || !json.Valid(items) || !validBridgeCompactItems(gjson.ParseBytes(items)) {
+		return "", errors.New("native compaction returned no canonical capsule")
+	}
+	raw, err := json.Marshal(map[string]any{"v": 1, "model": model, "output": json.RawMessage(items)})
+	if err != nil || len(raw) > bridgeCompactLimit {
+		return "", errors.New("native compaction capsule exceeds its limit")
+	}
+	token := base64.RawURLEncoding.EncodeToString(raw) + "." + hex.EncodeToString(bridgeCompactMAC(raw, key))
+	return "<summary>" + bridgeCompactLead + "\n" +
+		bridgeCompactPrefix + token + bridgeCompactSuffix + "\n</summary>", nil
+}
+
+func bridgeCompactMarker(text string) int {
+	for offset := 0; offset < len(text); {
+		start := strings.Index(text[offset:], bridgeCompactPrefix)
+		if start < 0 {
+			return -1
+		}
+		start += offset
+		if strings.HasSuffix(strings.TrimRight(text[:start], " \t\r\n"), bridgeCompactLead) {
+			return start
+		}
+		// A quoted source constant or documentation example is ordinary text.
+		offset = start + len(bridgeCompactPrefix)
+	}
+	return -1
+}
+
+func decodeBridgeCompact(token, key string) ([]byte, error) {
+	if len(token) > base64.RawURLEncoding.EncodedLen(bridgeCompactLimit)+65 {
+		return nil, errors.New("native context capsule exceeds its limit")
+	}
+	parts := strings.Split(token, ".")
+	if len(parts) != 2 {
+		return nil, errors.New("native context capsule is truncated")
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil || len(raw) > bridgeCompactLimit || !json.Valid(raw) {
+		return nil, errors.New("native context capsule is invalid")
+	}
+	signature, err := hex.DecodeString(parts[1])
+	if err != nil || !hmac.Equal(signature, bridgeCompactMAC(raw, key)) {
+		return nil, errors.New("native context signature is not trusted by this bridge")
+	}
+	value := gjson.ParseBytes(raw)
+	if value.Get("v").Int() != 1 || !validBridgeCompactItems(value.Get("output")) {
+		return nil, errors.New("native context capsule version or type is unsupported")
+	}
+	return []byte(value.Get("output").Raw), nil
+}
+
+// ReplayBridgeCompact runs before the final operator payload rules. It never
+// scans tool results. Claude owns history pruning; this only substitutes its
+// authenticated summary carrier. Every other current instruction/image/tool
+// item and every later turn survives unchanged.
+func ReplayBridgeCompact(body []byte, key string) ([]byte, bool, error) {
+	input := gjson.GetBytes(body, "input")
+	if !input.IsArray() {
+		return body, false, nil
+	}
+	rows := input.Array()
+	var capsule []byte
+	foundAt, foundPart := -1, -1
+	var cleaned string
+	for i, item := range rows {
+		role := item.Get("role").String()
+		if role != "user" && role != "assistant" {
+			continue
+		}
+		for j, part := range item.Get("content").Array() {
+			if part.Get("type").String() != "input_text" && part.Get("type").String() != "output_text" {
+				continue
+			}
+			text := part.Get("text").String()
+			start := bridgeCompactMarker(text)
+			if start < 0 {
+				continue
+			}
+			end := strings.Index(text[start+len(bridgeCompactPrefix):], bridgeCompactSuffix)
+			if end < 0 || foundAt >= 0 {
+				return nil, false, errors.New("native context capsule is truncated or duplicated")
+			}
+			end += start + len(bridgeCompactPrefix)
+			var err error
+			capsule, err = decodeBridgeCompact(text[start+len(bridgeCompactPrefix):end], key)
+			if err != nil {
+				return nil, false, err
+			}
+			cleaned = text[:start] + text[end+len(bridgeCompactSuffix):]
+			if bridgeCompactMarker(cleaned) >= 0 {
+				return nil, false, errors.New("native context capsule is duplicated")
+			}
+			foundAt, foundPart = i, j
+		}
+	}
+	if foundAt < 0 {
+		return body, false, nil
+	}
+	output := make([]json.RawMessage, 0, len(rows)+1)
+	for _, item := range gjson.ParseBytes(capsule).Array() {
+		output = append(output, json.RawMessage(item.Raw))
+	}
+	for _, item := range rows[:foundAt] {
+		output = append(output, json.RawMessage(item.Raw))
+	}
+	updated, err := sjson.SetBytes([]byte(rows[foundAt].Raw), "content."+strconv.Itoa(foundPart)+".text", cleaned)
+	if err != nil {
+		return nil, false, errors.New("native context continuation could not be rebuilt")
+	}
+	output = append(output, updated)
+	for _, item := range rows[foundAt+1:] {
+		output = append(output, json.RawMessage(item.Raw))
+	}
+	encoded, err := json.Marshal(output)
+	if err != nil {
+		return nil, false, errors.New("native context continuation could not be serialized")
+	}
+	result, err := sjson.SetRawBytes(body, "input", encoded)
+	return result, err == nil, err
+}
