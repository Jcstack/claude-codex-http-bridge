new file mode 100644
index 0000000..71b54a3
--- /dev/null
+++ b/internal/runtime/executor/codex_bridge_compaction.go
@@ -0,0 +1,132 @@
+package executor
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/thinking"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+func bridgeCompactRequested(opts cliproxyexecutor.Options, baseURL, key string) bool {
+	return opts.SourceFormat == sdktranslator.FormatClaude && helps.BridgeCompactLocal(baseURL, key) &&
+		opts.Headers.Get(helps.BridgeCompactHeader) == "1" &&
+		strings.EqualFold(opts.Headers.Get("X-Claude-Code-Request-Class"), "compaction")
+}
+
+// executeBridgeCompact uses the same typed V2 trigger as Codex 0.166. Normal
+// Claude reasoning settings are untouched. This dedicated native operation
+// leaves its own effort unset, as the native compaction service requires.
+func (e *CodexExecutor) executeBridgeCompact(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options, key string) (cliproxyexecutor.Response, error) {
+	baseModel := thinking.ParseSuffix(req.Model).ModelName
+	to := sdktranslator.FromString("codex")
+	body := sdktranslator.TranslateRequest(opts.SourceFormat, to, baseModel, req.Payload, false)
+	finalize := helps.NewPayloadFinalizer(e.cfg, e.Identifier(), baseModel, to.String(), "", body, req, opts)
+	var err error
+	body, _, err = helps.ReplayBridgeCompact(body, key)
+	if err != nil {
+		return cliproxyexecutor.Response{}, statusErr{code: http.StatusBadRequest, msg: err.Error()}
+	}
+	input := gjson.GetBytes(body, "input")
+	if !input.IsArray() {
+		return cliproxyexecutor.Response{}, statusErr{code: http.StatusBadRequest, msg: "native compaction requires conversation input"}
+	}
+	items := make([]json.RawMessage, 0, len(input.Array())+1)
+	for _, item := range input.Array() {
+		items = append(items, json.RawMessage(item.Raw))
+	}
+	items = append(items, json.RawMessage(`{"type":"compaction_trigger"}`))
+	body, err = sjson.SetBytes(body, "input", items)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	for _, field := range []string{"reasoning", "output_config", "max_output_tokens", "max_tokens", "stop", "stop_sequences", "previous_response_id", "context_management", "compaction"} {
+		body, _ = sjson.DeleteBytes(body, field)
+	}
+	body, _ = sjson.SetBytes(body, "store", false)
+	body, _ = sjson.SetBytes(body, "model", baseModel)
+	nativeOpts := opts
+	nativeOpts.SourceFormat, nativeOpts.ResponseFormat = to, to
+	nativeOpts.OriginalRequest = body
+	nativeOpts.Alt = ""
+	nativeOpts.Stream = false
+	native := req
+	native.Model, native.Payload, native.Format = baseModel, body, to
+	response, err := e.Execute(helps.WithBridgeCompactFinalizer(ctx, finalize), auth, native, nativeOpts)
+	if err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	result := gjson.ParseBytes(response.Payload)
+	if result.Get("type").String() == "response.completed" {
+		result = result.Get("response")
+	}
+	if state := result.Get("status").String(); state != "" && state != "completed" {
+		return cliproxyexecutor.Response{}, statusErr{code: http.StatusBadGateway, msg: "native compaction did not complete"}
+	}
+	output := result.Get("output")
+	summary, err := helps.BridgeCompactSummary([]byte(output.Raw), baseModel, key)
+	if err != nil {
+		return cliproxyexecutor.Response{}, statusErr{code: http.StatusBadGateway, msg: err.Error()}
+	}
+	var nonce [12]byte
+	if _, err = rand.Read(nonce[:]); err != nil {
+		return cliproxyexecutor.Response{}, err
+	}
+	total := result.Get("usage.input_tokens").Int()
+	cached := result.Get("usage.input_tokens_details.cached_tokens").Int()
+	if cached < 0 || cached > total {
+		cached = 0
+	}
+	model := gjson.GetBytes(opts.OriginalRequest, "model").String()
+	if model == "" {
+		model = req.Model
+	}
+	message := map[string]any{"id": "msg_native_compact_" + hex.EncodeToString(nonce[:]), "type": "message", "role": "assistant", "model": model,
+		"content": []any{map[string]any{"type": "text", "text": summary}}, "stop_reason": "end_turn", "stop_sequence": nil,
+		"usage": map[string]any{"input_tokens": total - cached, "cache_read_input_tokens": cached,
+			"cache_creation_input_tokens": 0, "output_tokens": result.Get("usage.output_tokens").Int()}}
+	payload, err := json.Marshal(message)
+	return cliproxyexecutor.Response{Payload: payload, Headers: response.Headers}, err
+}
+
+func (e *CodexExecutor) executeBridgeCompactStream(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options, key string) (*cliproxyexecutor.StreamResult, error) {
+	response, err := e.executeBridgeCompact(ctx, auth, req, opts, key)
+	if err != nil {
+		return nil, err
+	}
+	var message map[string]any
+	if err = json.Unmarshal(response.Payload, &message); err != nil {
+		return nil, err
+	}
+	text := gjson.GetBytes(response.Payload, "content.0.text").String()
+	message["content"], message["stop_reason"] = []any{}, nil
+	events := []map[string]any{
+		{"type": "message_start", "message": message},
+		{"type": "content_block_start", "index": 0, "content_block": map[string]any{"type": "text", "text": ""}},
+		{"type": "content_block_delta", "index": 0, "delta": map[string]any{"type": "text_delta", "text": text}},
+		{"type": "content_block_stop", "index": 0},
+		{"type": "message_delta", "delta": map[string]any{"stop_reason": "end_turn", "stop_sequence": nil},
+			"usage": map[string]any{"output_tokens": gjson.GetBytes(response.Payload, "usage.output_tokens").Int()}},
+		{"type": "message_stop"},
+	}
+	chunks := make(chan cliproxyexecutor.StreamChunk, len(events))
+	for _, event := range events {
+		data, errMarshal := json.Marshal(event)
+		if errMarshal != nil {
+			return nil, errMarshal
+		}
+		chunks <- cliproxyexecutor.StreamChunk{Payload: []byte(fmt.Sprintf("event: %s\ndata: %s\n\n", event["type"], data))}
+	}
+	close(chunks)
+	return &cliproxyexecutor.StreamResult{Chunks: chunks, Headers: http.Header{"Content-Type": {"text/event-stream"}}}, nil
+}
