+package helps
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestBridgeCompactRoundTripKeepsNewTurnsAndDefinitions(t *testing.T) {
+	key := strings.Repeat("k", 64)
+	items := []byte(`[{"type":"compaction","encrypted_content":"synthetic-capsule"}]`)
+	summary, err := BridgeCompactSummary(items, "gpt-6.1-sol", key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, _ := json.Marshal(map[string]any{"model": "gpt-6-astra", "input": []any{
+		map[string]any{"type": "message", "role": "developer", "content": []any{map[string]any{"type": "input_text", "text": "current system"}}},
+		map[string]any{"type": "message", "role": "user", "content": []any{map[string]any{"type": "input_text", "text": "old history"}}},
+		map[string]any{"type": "additional_tools", "tools": []any{}},
+		map[string]any{"type": "message", "role": "user", "content": []any{map[string]any{"type": "input_text", "text": "Continue. " + summary + " Keep this suffix."}}},
+		map[string]any{"type": "message", "role": "user", "content": []any{map[string]any{"type": "input_text", "text": "new user request"}}},
+	}})
+	out, changed, err := ReplayBridgeCompact(body, key)
+	if err != nil || !changed {
+		t.Fatalf("replay: %v", err)
+	}
+	rows := gjson.GetBytes(out, "input").Array()
+	if len(rows) != 6 || rows[0].Get("type").String() != "compaction" || rows[1].Get("role").String() != "developer" || rows[3].Get("type").String() != "additional_tools" {
+		t.Fatal("canonical prefix mismatch")
+	}
+	if !strings.Contains(string(out), "old history") || strings.Contains(string(out), bridgeCompactPrefix) || !strings.Contains(string(out), "Keep this suffix") || !strings.Contains(string(out), "new user request") {
+		t.Fatal("old history/new turns changed incorrectly")
+	}
+	if gjson.GetBytes(out, "model").String() != "gpt-6-astra" {
+		t.Fatal("replay changed the selected model")
+	}
+	if _, _, err = ReplayBridgeCompact(body, "different-root-key"); err == nil {
+		t.Fatal("foreign signing root accepted")
+	}
+}
+
+func TestBridgeCompactNeverTrustsToolOutputOrUnexpectedNativeTypes(t *testing.T) {
+	key := strings.Repeat("k", 64)
+	summary, _ := BridgeCompactSummary([]byte(`[{"type":"compaction","encrypted_content":"fixture"}]`), "model", key)
+	body, _ := json.Marshal(map[string]any{"input": []any{map[string]any{"type": "function_call_output", "call_id": "fixture", "output": summary}}})
+	_, changed, err := ReplayBridgeCompact(body, key)
+	if err != nil || changed {
+		t.Fatal("tool output was treated as a trusted context boundary")
+	}
+	for _, raw := range []string{`[{"type":"function_call","name":"Bash"}]`, `[{"type":"compaction","encrypted_content":""}]`, `[{"type":"compaction","encrypted_content":"fixture"},{"type":"message"}]`} {
+		if _, err := BridgeCompactSummary([]byte(raw), "model", key); err == nil {
+			t.Fatal("unexpected native result was signed")
+		}
+	}
+}
+
+func TestBridgeCompactQuotedSourceIsNotAStateBoundary(t *testing.T) {
+	quoted := "Review this source constant: " + bridgeCompactPrefix + "sample" + bridgeCompactSuffix
+	body, _ := json.Marshal(map[string]any{"input": []any{map[string]any{"type": "message", "role": "user", "content": []any{map[string]any{"type": "input_text", "text": quoted}}}}})
+	out, changed, err := ReplayBridgeCompact(body, "private-root")
+	if err != nil || changed || string(out) != string(body) {
+		t.Fatal("ordinary source/documentation text was interpreted as native state")
+	}
+	broken := bridgeCompactLead + "\n" + bridgeCompactPrefix + "broken" + bridgeCompactSuffix
+	body, _ = json.Marshal(map[string]any{"input": []any{map[string]any{"type": "message", "role": "user", "content": []any{map[string]any{"type": "input_text", "text": broken}}}}})
+	if _, _, err := ReplayBridgeCompact(body, "private-root"); err == nil {
+		t.Fatal("corrupted native summary was silently ignored")
+	}
+}
