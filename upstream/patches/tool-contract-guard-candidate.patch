+func TestToolContractStrictPreservedWithoutSchemaRewrite(t *testing.T) {
+	raw := []byte(`{"model":"fixture","messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","strict":true,"input_schema":{"type":"object","properties":{"value":{"type":"string"}},"required":["value"],"additionalProperties":false}}]}`)
+	got, err := ConvertClaudeRequestToCodex("fixture", raw, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !gjson.GetBytes(got, "tools.0.strict").Bool() {
+		t.Fatal("explicit strict mode was lost")
+	}
+	if !gjson.GetBytes(got, "tools.0.parameters.additionalProperties").Exists() || gjson.GetBytes(got, "tools.0.parameters.additionalProperties").Bool() {
+		t.Fatal("strict schema was not preserved")
+	}
+}
+
+func TestToolContractAbsentAndFalseStrictStayNonStrict(t *testing.T) {
+	for _, field := range []string{"", `,"strict":false`} {
+		raw := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","input_schema":{"type":"object","properties":{}}` + field + `}]}`)
+		got, err := ConvertClaudeRequestToCodex("fixture", raw, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if gjson.GetBytes(got, "tools.0.strict").Type != gjson.False {
+			t.Fatal("default tool mode changed")
+		}
+	}
+}
+
+func TestToolContractRejectsAmbiguousAndDeepDefinitions(t *testing.T) {
+	duplicate := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","strict":false,"strict":true,"input_schema":{"type":"object","properties":{}}}]}`)
+	if _, err := ConvertClaudeRequestToCodex("fixture", duplicate, false); err == nil {
+		t.Fatal("duplicate strict fields were accepted")
+	}
+	escapedDuplicate := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","\u0073trict":false,"strict":true,"input_schema":{"type":"object","properties":{}}}]}`)
+	if _, err := ConvertClaudeRequestToCodex("fixture", escapedDuplicate, false); err == nil {
+		t.Fatal("escaped duplicate strict fields were accepted")
+	}
+	escapedCaller := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","\u0061llowed_callers":["code_execution_20260120"],"input_schema":{"type":"object","properties":{}}}]}`)
+	if _, err := ConvertClaudeRequestToCodex("fixture", escapedCaller, false); err == nil {
+		t.Fatal("escaped caller policy was ignored")
+	}
+	schema := `{"type":"string"}`
+	for i := 0; i < 130; i++ {
+		schema = `{"items":` + schema + `}`
+	}
+	deep := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","strict":true,"input_schema":` + schema + `}]}`)
+	if _, err := ConvertClaudeRequestToCodex("fixture", deep, false); err == nil {
+		t.Fatal("excessive nesting was accepted")
+	}
+}
