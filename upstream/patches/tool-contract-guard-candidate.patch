+// decodeUniqueToolJSON rejects ambiguous duplicate keys before comparing a
+// strict schema. Object ordering is irrelevant; arrays and values are kept.
+func decodeUniqueToolJSON(raw string) (any, error) {
+	decoder := json.NewDecoder(strings.NewReader(raw))
+	decoder.UseNumber()
+	depth := 0
+	var read func() (any, error)
+	read = func() (any, error) {
+		token, err := decoder.Token()
+		if err != nil {
+			return nil, err
+		}
+		delim, container := token.(json.Delim)
+		if !container {
+			return token, nil
+		}
+		depth++
+		if depth > 128 {
+			return nil, fmt.Errorf("JSON nesting limit exceeded")
+		}
+		defer func() { depth-- }()
+		switch delim {
+		case '{':
+			result := map[string]any{}
+			for decoder.More() {
+				keyToken, err := decoder.Token()
+				if err != nil {
+					return nil, err
+				}
+				key, ok := keyToken.(string)
+				if !ok {
+					return nil, fmt.Errorf("invalid object key")
+				}
+				if _, exists := result[key]; exists {
+					return nil, fmt.Errorf("duplicate object key")
+				}
+				value, err := read()
+				if err != nil {
+					return nil, err
+				}
+				result[key] = value
+			}
+			end, err := decoder.Token()
+			if err != nil || end != json.Delim('}') {
+				return nil, fmt.Errorf("invalid object end")
+			}
+			return result, nil
+		case '[':
+			result := []any{}
+			for decoder.More() {
+				value, err := read()
+				if err != nil {
+					return nil, err
+				}
+				result = append(result, value)
+			}
+			end, err := decoder.Token()
+			if err != nil || end != json.Delim(']') {
+				return nil, fmt.Errorf("invalid array end")
+			}
+			return result, nil
+		default:
+			return nil, fmt.Errorf("unexpected JSON delimiter")
+		}
+	}
+	result, err := read()
+	if err != nil {
+		return nil, err
+	}
+	if _, err = decoder.Token(); err != io.EOF {
+		return nil, fmt.Errorf("unexpected trailing JSON")
+	}
+	return result, nil
+}
