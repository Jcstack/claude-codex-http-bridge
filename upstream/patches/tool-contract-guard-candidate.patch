+
+func TestToolContractRejectsWeakenedStrictSchema(t *testing.T) {
+	cases := []string{
+		`{"type":"object","properties":{"value":{"type":"string","pattern":"\\p{L}+"}},"required":["value"],"additionalProperties":false}`,
+		`{"$id":"https://fixture.invalid/schema","type":"object","properties":{},"additionalProperties":false}`,
+		`{"type":"object","additionalProperties":false}`,
+		`null`,
+	}
+	for _, schema := range cases {
+		raw := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","strict":true,"input_schema":` + schema + `}]}`)
+		_, err := ConvertClaudeRequestToCodex("fixture", raw, false)
+		if policy, ok := err.(*claudeToolPolicyError); !ok || policy.StatusCode() != 400 || !policy.IsRequestScoped() {
+			t.Fatalf("strict schema rewrite was not rejected as request-scoped: %v", err)
+		}
+	}
+}
+
+func TestToolContractCallerRestrictions(t *testing.T) {
+	cases := []struct {
+		callers  string
+		rejected bool
+	}{
+		{`["direct"]`, false},
+		{`["direct","code_execution_20260120"]`, false},
+		{`["code_execution_20260120"]`, true},
+		{`[]`, true},
+		{`["future_unknown"]`, true},
+		{`["direct",1]`, true},
+		{`null`, true},
+	}
+	for _, tc := range cases {
+		raw := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","allowed_callers":` + tc.callers + `,"input_schema":{"type":"object","properties":{}}}]}`)
+		_, err := ConvertClaudeRequestToCodex("fixture", raw, false)
+		if tc.rejected {
+			if policy, ok := err.(*claudeToolPolicyError); !ok || policy.StatusCode() != 400 || !policy.IsRequestScoped() {
+				t.Fatalf("caller policy was not rejected as request-scoped for %s: %v", tc.callers, err)
+			}
+		} else if err != nil {
+			t.Fatalf("direct caller was rejected: %v", err)
+		}
+	}
+}
