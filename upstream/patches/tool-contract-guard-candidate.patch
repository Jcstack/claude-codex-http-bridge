+func validateClaudeToolContract(tool gjson.Result) error {
+	strict, callers := tool.Get("strict"), tool.Get("allowed_callers")
+	if !strict.Exists() && !callers.Exists() {
+		return nil
+	}
+	if _, err := decodeUniqueToolJSON(tool.Raw); err != nil {
+		return &claudeToolPolicyError{"Ambiguous tool definition; request not sent upstream"}
+	}
+	if callers.Exists() {
+		if !callers.IsArray() {
+			return &claudeToolPolicyError{"Unsupported tool caller policy; request not sent upstream"}
+		}
+		direct := false
+		for _, caller := range callers.Array() {
+			if caller.Type != gjson.String {
+				return &claudeToolPolicyError{"Unsupported tool caller policy; request not sent upstream"}
+			}
+			switch caller.String() {
+			case "direct":
+				direct = true
+			case "code_execution_20260120", "code_execution_20260521":
+			default:
+				return &claudeToolPolicyError{"Unsupported tool caller policy; request not sent upstream"}
+			}
+		}
+		if !direct {
+			return &claudeToolPolicyError{"Tool disallows direct calls; request not sent upstream"}
+		}
+	}
+	if strict.Exists() {
+		if strict.Type != gjson.True && strict.Type != gjson.False {
+			return &claudeToolPolicyError{"Invalid strict tool setting; request not sent upstream"}
+		}
+		if strict.Type == gjson.True {
+			schema := tool.Get("input_schema")
+			if !schema.IsObject() {
+				return &claudeToolPolicyError{"Strict tool schema is unavailable; request not sent upstream"}
+			}
+			before, errBefore := decodeUniqueToolJSON(schema.Raw)
+			after, errAfter := decodeUniqueToolJSON(normalizeToolParameters(schema.Raw))
+			if errBefore != nil || errAfter != nil || !reflect.DeepEqual(before, after) {
+				return &claudeToolPolicyError{"Strict tool schema would change; request not sent upstream"}
+			}
+		}
+	}
+	return nil
+}
+
+func validateClaudeToolContracts(tools gjson.Result) error {
+	if tools.IsArray() {
+		for _, tool := range tools.Array() {
+			if tool.IsObject() {
+				if err := validateClaudeToolContract(tool); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func validateClaudeSystemToolContracts(content gjson.Result) error {
+	if content.IsArray() {
+		for _, part := range content.Array() {
+			if part.Get("type").String() != "tool_addition" {
+				continue
+			}
+			if definition := part.Get("tool.definition"); definition.IsObject() {
+				if err := validateClaudeToolContract(definition); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	return nil
+}
