diff --git a/internal/runtime/executor/codex_stream_observation.go b/internal/runtime/executor/codex_stream_observation.go
new file mode 100644
index 00000000..867a99bf
--- /dev/null
+++ b/internal/runtime/executor/codex_stream_observation.go
@@ -0,0 +1,153 @@
+package executor
+
+// A disabled-by-default, metadata-only observation for an incomplete stream.
+// It never changes a request, stream, error, retry, or credential selection.
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+type codexStreamObservation struct {
+	started          time.Time
+	expires          time.Time
+	lastRead         time.Time
+	lastEventAt      time.Time
+	items            uint32
+	last             string
+	previous         string
+	eventGapMillis   int64
+	maxReadGapMillis int64
+}
+
+// An opted-in process stops recording after one hour even if it remains alive.
+// The monotonic portion of time.Time makes this independent of wall-clock jumps.
+var codexStreamObservationExpiry = time.Now().Add(time.Hour)
+
+func newCodexStreamObservation() *codexStreamObservation {
+	now := time.Now()
+	if os.Getenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS") != "1" || !now.Before(codexStreamObservationExpiry) {
+		return nil
+	}
+	return &codexStreamObservation{started: now, expires: codexStreamObservationExpiry, lastRead: now, lastEventAt: now, last: "none", previous: "none"}
+}
+
+// Scanner callbacks and frame observations are sequential, including the
+// bootstrap-to-stream goroutine handoff. No frame or request bytes are stored.
+func (d *codexStreamObservation) noteRead() {
+	if d != nil {
+		now := time.Now()
+		if gap := codexObservationMillis(d.lastRead, now); gap > d.maxReadGapMillis {
+			d.maxReadGapMillis = gap
+		}
+		d.lastRead = now
+	}
+}
+
+func (d *codexStreamObservation) observe(line []byte) {
+	if d == nil || !bytes.HasPrefix(line, dataTag) {
+		return
+	}
+	if d.items < 1_000_000 {
+		d.items++
+	}
+	now := time.Now()
+	d.eventGapMillis = codexObservationMillis(d.lastEventAt, now)
+	d.lastEventAt = now
+	d.previous = d.last
+	value := gjson.GetBytes(bytes.TrimSpace(line[len(dataTag):]), "type")
+	if value.Type != gjson.String {
+		d.last = "other"
+		return
+	}
+	switch value.String() {
+	case "response.created", "response.in_progress", "response.output_item.added", "response.output_item.done",
+		"response.output_text.delta", "response.reasoning_summary_text.delta", "response.reasoning_summary_part.added",
+		"response.function_call_arguments.delta", "response.completed", "response.incomplete", "response.failed",
+		"error", "codex.rate_limits", "codex.response.metadata", "keepalive", "ping":
+		d.last = value.String()
+	default:
+		d.last = "other"
+	}
+}
+
+func codexObservationReadError(err error) string {
+	switch {
+	case err == nil:
+		return "none"
+	case errors.Is(err, io.ErrUnexpectedEOF):
+		return "unexpected_eof"
+	case errors.Is(err, context.Canceled):
+		return "cancelled"
+	case errors.Is(err, context.DeadlineExceeded):
+		return "timeout"
+	}
+	var network net.Error
+	if errors.As(err, &network) && network.Timeout() {
+		return "timeout"
+	}
+	return "other"
+}
+
+func codexObservationMillis(start, now time.Time) int64 {
+	value := now.Sub(start)
+	if value < 0 {
+		return 0
+	}
+	if value > 24*time.Hour {
+		value = 24 * time.Hour
+	}
+	return value.Milliseconds()
+}
+
+// Only an eight-character suffix of a canonical local UUID may be logged.
+func codexObservationRequestTag(ctx context.Context) string {
+	id := logging.GetRequestID(ctx)
+	if len(id) != 36 {
+		return ""
+	}
+	for i := 0; i < len(id); i++ {
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			if id[i] != '-' {
+				return ""
+			}
+			continue
+		}
+		if !(id[i] >= '0' && id[i] <= '9' || id[i] >= 'a' && id[i] <= 'f') {
+			return ""
+		}
+	}
+	return id[28:]
+}
+
+func (d *codexStreamObservation) emit(ctx context.Context, phase, outcome string, readErr error) {
+	if d == nil || ctx == nil || ctx.Err() != nil || !time.Now().Before(d.expires) {
+		return
+	}
+	if phase != "bootstrap" && phase != "stream" {
+		phase = "other"
+	}
+	if outcome != "terminal_event" && outcome != "incomplete_event" && outcome != "read_error" && outcome != "eof" {
+		outcome = "other"
+	}
+	now := time.Now()
+	// These intervals include downstream work and backpressure. They do not
+	// measure upstream network silence; the clock starts after response headers.
+	message := fmt.Sprintf("codex stream observation: phase=%s outcome=%s last_event=%s prior_event=%s data_items=%d elapsed_ms=%d since_read_ms=%d event_gap_ms=%d max_read_gap_ms=%d read_error=%s",
+		phase, outcome, d.last, d.previous, d.items, codexObservationMillis(d.started, now), codexObservationMillis(d.lastRead, now), d.eventGapMillis, d.maxReadGapMillis, codexObservationReadError(readErr))
+	entry := log.NewEntry(log.StandardLogger())
+	if tag := codexObservationRequestTag(ctx); tag != "" {
+		entry = entry.WithField("request_id", tag)
+	}
+	entry.Warn(message)
+}
diff --git a/internal/runtime/executor/codex_stream_observation_test.go b/internal/runtime/executor/codex_stream_observation_test.go
new file mode 100644
index 00000000..b7f7458a
--- /dev/null
+++ b/internal/runtime/executor/codex_stream_observation_test.go
@@ -0,0 +1,243 @@
+package executor
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	_ "github.com/router-for-me/CLIProxyAPI/v8/internal/translator"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	log "github.com/sirupsen/logrus"
+)
+
+const observationSecret = "SYNTHETIC_PRIVATE_DO_NOT_RECORD"
+
+type observationHook struct {
+	mu      sync.Mutex
+	entries []*log.Entry
+}
+
+func (*observationHook) Levels() []log.Level { return log.AllLevels }
+func (h *observationHook) Fire(entry *log.Entry) error {
+	if strings.HasPrefix(entry.Message, "codex stream observation:") {
+		h.mu.Lock()
+		copy := entry.Dup()
+		copy.Message = entry.Message
+		h.entries = append(h.entries, copy)
+		h.mu.Unlock()
+	}
+	return nil
+}
+func (h *observationHook) snapshot() []*log.Entry {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return append([]*log.Entry(nil), h.entries...)
+}
+
+func TestBridgeStreamObservationRedactsUntrustedInputs(t *testing.T) {
+	t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+	hook := &observationHook{}
+	logger := log.StandardLogger()
+	old := logger.ReplaceHooks(make(log.LevelHooks))
+	defer logger.ReplaceHooks(old)
+	logger.AddHook(hook)
+	d := newCodexStreamObservation()
+	d.noteRead()
+	d.observe([]byte(`data: {"type":{"secret":"` + observationSecret + `"}}`))
+	d.emit(logging.WithRequestID(context.Background(), observationSecret), observationSecret, observationSecret, errors.New(observationSecret))
+	entries := hook.snapshot()
+	if len(entries) != 1 || strings.Contains(entries[0].Message, observationSecret) {
+		t.Fatal("untrusted diagnostic inputs escaped the fixed vocabulary")
+	}
+	if !strings.Contains(entries[0].Message, "phase=other outcome=other last_event=other") ||
+		!strings.Contains(entries[0].Message, "read_error=other") {
+		t.Fatal("invalid values were not reduced to fixed categories")
+	}
+	if _, ok := entries[0].Data["request_id"]; ok {
+		t.Fatal("an untrusted request ID was retained")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	d.emit(ctx, "stream", "eof", nil)
+	if len(hook.snapshot()) != 1 {
+		t.Fatal("a cancelled request emitted a failure observation")
+	}
+	d.expires = time.Now().Add(-time.Second)
+	d.emit(context.Background(), "stream", "eof", nil)
+	if len(hook.snapshot()) != 1 {
+		t.Fatal("an expired observer emitted a failure observation")
+	}
+	if codexObservationMillis(time.Unix(10, 0), time.Unix(5, 0)) != 0 ||
+		codexObservationMillis(time.Unix(0, 0), time.Unix(1000000, 0)) != (24*time.Hour).Milliseconds() {
+		t.Fatal("duration bounds were not enforced")
+	}
+}
+
+func TestBridgeStreamObservationThroughFakeUpstream(t *testing.T) {
+	cases := []struct {
+		name, payload, outcome, last string
+		wantError                    bool
+	}{
+		{"eof", `data: {"type":"response.created","response":{"id":"fixture"}}` + "\n\n" +
+			`data: {"type":"response.output_text.delta","delta":"` + observationSecret + `"}` + "\n\n", "eof", "response.output_text.delta", true},
+		{"terminal", `data: {"type":"response.created","response":{"id":"fixture"}}` + "\n\n" +
+			`data: {"type":"error","error":{"type":"server_error","code":"request_timeout","message":"` + observationSecret + `"}}` + "\n\n", "terminal_event", "error", true},
+		{"complete", `data: {"type":"response.completed","response":{"id":"fixture","status":"completed","output":[]}}` + "\n\n", "", "", false},
+	}
+	for _, buffered := range []bool{false, true} {
+		for _, tc := range cases {
+			t.Run(tc.name+map[bool]string{false: "-direct", true: "-bootstrap"}[buffered], func(t *testing.T) {
+				t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+				hook := &observationHook{}
+				logger := log.StandardLogger()
+				old := logger.ReplaceHooks(make(log.LevelHooks))
+				defer logger.ReplaceHooks(old)
+				logger.AddHook(hook)
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = io.WriteString(w, tc.payload)
+				}))
+				defer server.Close()
+				cfg := &config.Config{}
+				cfg.Codex.StreamBootstrapBuffering = buffered
+				executor := NewCodexExecutor(cfg)
+				auth := &cliproxyauth.Auth{Attributes: map[string]string{"base_url": server.URL, "api_key": "fixture"}}
+				ctx := logging.WithRequestID(context.Background(), "00000000-0000-4000-8000-abcdef012345")
+				result, err := executor.ExecuteStream(ctx, auth, cliproxyexecutor.Request{
+					Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","input":"fixture"}`),
+				}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), Stream: true})
+				gotError := err != nil
+				if result != nil {
+					for chunk := range result.Chunks {
+						gotError = gotError || chunk.Err != nil
+					}
+				}
+				if gotError != tc.wantError {
+					t.Fatalf("unexpected synthetic stream error state: %t", gotError)
+				}
+				entries := hook.snapshot()
+				if tc.outcome == "" {
+					if len(entries) != 0 {
+						t.Fatal("successful stream produced an observation")
+					}
+					return
+				}
+				if len(entries) != 1 || !strings.Contains(entries[0].Message, "outcome="+tc.outcome) ||
+					!strings.Contains(entries[0].Message, "last_event="+tc.last) || strings.Contains(entries[0].Message, observationSecret) {
+					t.Fatal("synthetic stream did not produce one safe expected observation")
+				}
+				if entries[0].Data["request_id"] != "ef012345" {
+					t.Fatal("observation did not retain only the local short request tag")
+				}
+			})
+		}
+	}
+}
+
+func TestBridgeStreamObservationDisabledByDefault(t *testing.T) {
+	t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "")
+	if newCodexStreamObservation() != nil {
+		t.Fatal("observation enabled without explicit opt-in")
+	}
+	var disabled *codexStreamObservation
+	disabled.noteRead()
+	disabled.observe([]byte(`data: {"type":"error"}`))
+	disabled.emit(context.Background(), "stream", "eof", nil)
+	t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+	oldExpiry := codexStreamObservationExpiry
+	codexStreamObservationExpiry = time.Now().Add(-time.Second)
+	defer func() { codexStreamObservationExpiry = oldExpiry }()
+	if newCodexStreamObservation() != nil {
+		t.Fatal("observation enabled after the one-hour process window")
+	}
+}
+
+func TestBridgeStreamObservationPriorEventAndGapAreBounded(t *testing.T) {
+	t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+	hook := &observationHook{}
+	logger := log.StandardLogger()
+	old := logger.ReplaceHooks(make(log.LevelHooks))
+	defer logger.ReplaceHooks(old)
+	logger.AddHook(hook)
+	d := newCodexStreamObservation()
+	d.noteRead()
+	d.observe([]byte(`data: {"type":"response.output_text.delta","delta":"` + observationSecret + `"}`))
+	d.lastRead = time.Now().Add(-4 * time.Second)
+	d.lastEventAt = time.Now().Add(-3 * time.Second)
+	d.noteRead()
+	d.observe([]byte(`data: {"type":"error","error":{"message":"` + observationSecret + `"}}`))
+	d.emit(context.Background(), "stream", "terminal_event", nil)
+	entries := hook.snapshot()
+	if len(entries) != 1 || strings.Contains(entries[0].Message, observationSecret) ||
+		!strings.Contains(entries[0].Message, "last_event=error prior_event=response.output_text.delta") {
+		t.Fatal("event history was not limited to fixed categories")
+	}
+	if d.eventGapMillis < 2900 || d.eventGapMillis > (24*time.Hour).Milliseconds() ||
+		d.maxReadGapMillis < 3900 || d.maxReadGapMillis > (24*time.Hour).Milliseconds() {
+		t.Fatal("bounded synthetic event and read gaps were not captured")
+	}
+}
+
+func TestBridgeStreamObservationPreservesSyntheticStream(t *testing.T) {
+	cases := []string{
+		`data: {"type":"response.output_text.delta","delta":"text"}` + "\n\n" +
+			`data: {"type":"response.completed","response":{"id":"fixture","status":"completed","output":[]}}` + "\n\n",
+		`data: {"type":"response.created","response":{"id":"fixture"}}` + "\n\n" +
+			`data: {"type":"response.function_call_arguments.delta","item_id":"fixture","delta":"{\"x\":"}` + "\n\n",
+		`data: {"type":"response.created","response":{"id":"fixture"}}` + "\n\n" +
+			`data: {"type":"error","error":{"type":"server_error","code":"request_timeout","message":"fixture"}}` + "\n\n",
+	}
+	for _, buffered := range []bool{false, true} {
+		for _, payload := range cases {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = io.WriteString(w, payload)
+			}))
+			var outputs [][]string
+			for _, enabled := range []bool{false, true} {
+				if enabled {
+					t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+				} else {
+					t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "")
+				}
+				cfg := &config.Config{}
+				cfg.Codex.StreamBootstrapBuffering = buffered
+				executor := NewCodexExecutor(cfg)
+				auth := &cliproxyauth.Auth{Attributes: map[string]string{"base_url": server.URL, "api_key": "fixture"}}
+				result, err := executor.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{
+					Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","input":"fixture"}`),
+				}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), Stream: true})
+				output := []string{}
+				if err != nil {
+					output = append(output, "initial-error:"+err.Error())
+				}
+				if result != nil {
+					for chunk := range result.Chunks {
+						if len(chunk.Payload) != 0 {
+							output = append(output, "payload:"+string(chunk.Payload))
+						}
+						if chunk.Err != nil {
+							output = append(output, "stream-error:"+chunk.Err.Error())
+						}
+					}
+				}
+				outputs = append(outputs, output)
+			}
+			server.Close()
+			if !reflect.DeepEqual(outputs[0], outputs[1]) {
+				t.Fatal("enabling observation changed synthetic stream output")
+			}
+		}
+	}
+}
