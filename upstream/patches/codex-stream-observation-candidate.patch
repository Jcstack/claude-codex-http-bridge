+func TestBridgeStreamObservationPreservesSyntheticStream(t *testing.T) {
+	cases := []string{
+		`data: {"type":"response.output_text.delta","delta":"text"}` + "\n\n" +
+			`data: {"type":"response.completed","response":{"id":"fixture","status":"completed","output":[]}}` + "\n\n",
+		`data: {"type":"response.created","response":{"id":"fixture"}}` + "\n\n" +
+			`data: {"type":"response.function_call_arguments.delta","item_id":"fixture","delta":"{\"x\":"}` + "\n\n",
+		`data: {"type":"response.created","response":{"id":"fixture"}}` + "\n\n" +
+			`data: {"type":"error","error":{"type":"server_error","code":"request_timeout","message":"fixture"}}` + "\n\n",
+	}
+	for _, buffered := range []bool{false, true} {
+		for _, payload := range cases {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = io.WriteString(w, payload)
+			}))
+			var outputs [][]string
+			for _, enabled := range []bool{false, true} {
+				if enabled {
+					t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "1")
+				} else {
+					t.Setenv("CLAUDE_CODEX_STREAM_DIAGNOSTICS", "")
+				}
+				cfg := &config.Config{}
+				cfg.Codex.StreamBootstrapBuffering = buffered
+				executor := NewCodexExecutor(cfg)
+				auth := &cliproxyauth.Auth{Attributes: map[string]string{"base_url": server.URL, "api_key": "fixture"}}
+				result, err := executor.ExecuteStream(context.Background(), auth, cliproxyexecutor.Request{
+					Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","input":"fixture"}`),
+				}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), Stream: true})
+				output := []string{}
+				if err != nil {
+					output = append(output, "initial-error:"+err.Error())
+				}
+				if result != nil {
+					for chunk := range result.Chunks {
+						if len(chunk.Payload) != 0 {
+							output = append(output, "payload:"+string(chunk.Payload))
+						}
+						if chunk.Err != nil {
+							output = append(output, "stream-error:"+chunk.Err.Error())
+						}
+					}
+				}
+				outputs = append(outputs, output)
+			}
+			server.Close()
+			if !reflect.DeepEqual(outputs[0], outputs[1]) {
+				t.Fatal("enabling observation changed synthetic stream output")
+			}
+		}
+	}
+}
