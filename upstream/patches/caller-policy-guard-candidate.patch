+func TestCallerPolicyLeavesStrictBehaviorUnchanged(t *testing.T) {
+	for _, field := range []string{"", `,"strict":false`, `,"strict":true`} {
+		raw := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","input_schema":{"type":"object","properties":{}}` + field + `}]}`)
+		got, err := ConvertClaudeRequestToCodex("fixture", raw, false)
+		if err != nil || gjson.GetBytes(got, "tools.0.strict").Type != gjson.False {
+			t.Fatal("unrelated strict translation behavior changed")
+		}
+	}
+}
+
+func TestCallerPolicyCases(t *testing.T) {
+	cases := []struct {
+		callers  string
+		rejected bool
+	}{
+		{`["direct"]`, false},
+		{`["direct","code_execution_20260120"]`, false},
+		{`["direct","code_execution_20260521"]`, false},
+		{`["code_execution_20260120"]`, true},
+		{`["code_execution_20260521"]`, true},
+		{`[]`, true},
+		{`["future_unknown"]`, true},
+		{`["direct","future_unknown"]`, true},
+		{`["direct",1]`, true},
+		{`null`, true},
+		{`"direct"`, true},
+	}
+	for _, tc := range cases {
+		raw := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[{"name":"fixture_tool","allowed_callers":` + tc.callers + `,"input_schema":{"type":"object","properties":{}}}]}`)
+		_, err := ConvertClaudeRequestToCodex("fixture", raw, false)
+		if tc.rejected {
+			if policy, ok := err.(*claudeToolPolicyError); !ok || policy.StatusCode() != 400 || !policy.IsRequestScoped() {
+				t.Fatal("invalid synthetic caller policy was not rejected as request-scoped")
+			}
+		} else if err != nil {
+			t.Fatal("explicit direct caller was rejected")
+		}
+	}
+}
+
+func TestCallerPolicyRejectsAmbiguityAndDeepDefinitions(t *testing.T) {
+	cases := []string{
+		`{"name":"fixture_tool","allowed_callers":["direct"],"allowed_callers":["code_execution_20260120"],"input_schema":{"type":"object","properties":{}}}`,
+		`{"name":"fixture_tool","\u0061llowed_callers":["direct"],"allowed_callers":["code_execution_20260120"],"input_schema":{"type":"object","properties":{}}}`,
+		`{"name":"fixture_tool","\u0061llowed_callers":["code_execution_20260120"],"input_schema":{"type":"object","properties":{}}}`,
+	}
+	schema := `{"type":"string"}`
+	for i := 0; i < 130; i++ {
+		schema = `{"items":` + schema + `}`
+	}
+	cases = append(cases, `{"name":"fixture_tool","allowed_callers":["direct"],"input_schema":`+schema+`}`)
+	for _, tool := range cases {
+		raw := []byte(`{"messages":[{"role":"user","content":"fixture"}],"tools":[` + tool + `]}`)
+		if _, err := ConvertClaudeRequestToCodex("fixture", raw, false); err == nil {
+			t.Fatal("ambiguous or deeply nested synthetic caller policy was accepted")
+		}
+	}
+}
+
+func TestCallerPolicyChecksOnlyRealToolDefinitions(t *testing.T) {
+	user := []byte(`{"messages":[{"role":"user","content":[{"type":"text","text":"allowed_callers"},{"type":"tool_addition","tool":{"type":"tool_definition","definition":{"name":"fixture_tool","allowed_callers":["code_execution_20260120"]}}}]}]}`)
+	_, err := ConvertClaudeRequestToCodex("fixture", user, false)
+	if err != nil && strings.Contains(err.Error(), "caller") {
+		t.Fatal("user content was treated as a system tool definition")
+	}
+	restricted := []byte(`{"messages":[{"role":"user","content":"fixture"},{"role":"system","content":[{"type":"tool_addition","tool":{"type":"tool_definition","definition":{"name":"fixture_tool","allowed_callers":["code_execution_20260120"],"input_schema":{"type":"object","properties":{}}}}}]}]}`)
+	if _, err := ConvertClaudeRequestToCodex("fixture", restricted, false); err == nil {
+		t.Fatal("restricted synthetic additional tool was accepted")
+	}
+}
+
+func TestCallerPolicyResourceBounds(t *testing.T) {
+	tooLarge := `{"name":"fixture","allowed_callers":["direct"],"description":"` + strings.Repeat("x", callerPolicyToolByteLimit) + `"}`
+	tooMany := `{"name":"fixture","allowed_callers":["direct"],"input_schema":{"enum":[` + strings.Repeat("0,", callerPolicyTokenLimit) + `0]}}`
+	for _, tool := range []string{tooLarge, tooMany} {
+		if err := validateClaudeToolContract(gjson.Parse(tool)); err == nil {
+			t.Fatal("oversized synthetic caller-policy definition was accepted")
+		}
+	}
+	unrelated := `{"name":"fixture","description":"` + strings.Repeat("x", callerPolicyToolByteLimit) + `"}`
+	if err := validateClaudeToolContract(gjson.Parse(unrelated)); err != nil {
+		t.Fatal("a tool without caller policy was newly limited")
+	}
+}
