+const callerPolicyToolByteLimit = 4 << 20
+const callerPolicyTokenLimit = 100000
+const callerPolicyDepthLimit = 128
+
+// validateUniqueToolJSON rejects ambiguous duplicate keys in a tool carrying
+// a caller policy, without retaining the parsed schema or its values.
+func validateUniqueToolJSON(raw string) error {
+	if len(raw) > callerPolicyToolByteLimit {
+		return fmt.Errorf("tool definition size limit exceeded")
+	}
+	decoder := json.NewDecoder(strings.NewReader(raw))
+	decoder.UseNumber()
+	depth, tokens := 0, 0
+	var next func() (json.Token, error)
+	next = func() (json.Token, error) {
+		tokens++
+		if tokens > callerPolicyTokenLimit {
+			return nil, fmt.Errorf("JSON token limit exceeded")
+		}
+		return decoder.Token()
+	}
+	var read func() error
+	read = func() error {
+		token, err := next()
+		if err != nil {
+			return err
+		}
+		delim, container := token.(json.Delim)
+		if !container {
+			return nil
+		}
+		depth++
+		if depth > callerPolicyDepthLimit {
+			return fmt.Errorf("JSON nesting limit exceeded")
+		}
+		defer func() { depth-- }()
+		switch delim {
+		case '{':
+			keys := map[string]struct{}{}
+			for decoder.More() {
+				keyToken, err := next()
+				if err != nil {
+					return err
+				}
+				key, ok := keyToken.(string)
+				if !ok {
+					return fmt.Errorf("invalid object key")
+				}
+				if _, exists := keys[key]; exists {
+					return fmt.Errorf("duplicate object key")
+				}
+				keys[key] = struct{}{}
+				if err := read(); err != nil {
+					return err
+				}
+			}
+			end, err := next()
+			if err != nil || end != json.Delim('}') {
+				return fmt.Errorf("invalid object end")
+			}
+			return nil
+		case '[':
+			for decoder.More() {
+				if err := read(); err != nil {
+					return err
+				}
+			}
+			end, err := next()
+			if err != nil || end != json.Delim(']') {
+				return fmt.Errorf("invalid array end")
+			}
+			return nil
+		default:
+			return fmt.Errorf("unexpected JSON delimiter")
+		}
+	}
+	if err := read(); err != nil {
+		return err
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return fmt.Errorf("unexpected trailing JSON")
+	}
+	return nil
+}
+
+func validateClaudeToolContract(tool gjson.Result) error {
+	callers := tool.Get("allowed_callers")
+	if !callers.Exists() {
+		return nil
+	}
+	if err := validateUniqueToolJSON(tool.Raw); err != nil {
+		return &claudeToolPolicyError{"Tool definition ambiguous or exceeds policy limits; request not sent upstream"}
+	}
+	if callers.Exists() {
+		if !callers.IsArray() {
+			return &claudeToolPolicyError{"Unsupported tool caller policy; request not sent upstream"}
+		}
+		direct := false
+		for _, caller := range callers.Array() {
+			if caller.Type != gjson.String {
+				return &claudeToolPolicyError{"Unsupported tool caller policy; request not sent upstream"}
+			}
+			switch caller.String() {
+			case "direct":
+				direct = true
+			case "code_execution_20260120", "code_execution_20260521":
+			default:
+				return &claudeToolPolicyError{"Unsupported tool caller policy; request not sent upstream"}
+			}
+		}
+		if !direct {
+			return &claudeToolPolicyError{"Tool disallows direct calls; request not sent upstream"}
+		}
+	}
+	return nil
+}
+
+func validateClaudeToolContracts(tools gjson.Result) error {
+	if tools.IsArray() {
+		for _, tool := range tools.Array() {
+			if tool.IsObject() {
+				if err := validateClaudeToolContract(tool); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func validateClaudeSystemToolContracts(content gjson.Result) error {
+	if content.IsArray() {
+		for _, part := range content.Array() {
+			if part.Get("type").String() != "tool_addition" {
+				continue
+			}
+			if definition := part.Get("tool.definition"); definition.IsObject() {
+				if err := validateClaudeToolContract(definition); err != nil {
+					return err
+				}
+			}
+		}
+	}
+	return nil
+}
