diff --git a/internal/translator/codex/claude/codex_web_replay_test.go b/internal/translator/codex/claude/codex_web_replay_test.go
new file mode 100644
index 0000000..46ac626
--- /dev/null
+++ b/internal/translator/codex/claude/codex_web_replay_test.go
@@ -0,0 +1,95 @@
+package claude
+
+import (
+	"context"
+	"encoding/base64"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const replayFixture = `{"id":"ws_fixture","type":"web_search_call","status":"completed","encrypted_content":"synthetic-web-state","action":{"type":"search","query":"fixture","sources":[{"type":"url","url":"https://fixture.invalid/docs","title":"Fixture"}]}}`
+
+func TestWebReplaySurvivesTranslationWithoutProcessMemory(t *testing.T) {
+	response := []byte(`{"type":"response.completed","response":{"output":[` + replayFixture + `]}}`)
+	converted := ConvertCodexResponseToClaudeNonStream(context.Background(), "gpt-6.1-sol", nil, nil, response, nil)
+	request := []byte(`{"messages":[{"role":"assistant","content":[]}]}`)
+	request, _ = sjson.SetRawBytes(request, "messages.0.content", []byte(gjson.GetBytes(converted, "content").Raw))
+	replayed, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", request, false)
+	if err != nil || gjson.GetBytes(replayed, "input.0").Raw != replayFixture {
+		t.Fatalf("native search item changed on replay: %s (%v)", replayed, err)
+	}
+	if gjson.GetBytes(replayed, "input.#").Int() != 1 {
+		t.Fatal("search state was duplicated")
+	}
+	request, _ = sjson.SetBytes(request, "messages.0.role", "user")
+	replayed, _ = ConvertClaudeRequestToCodex("gpt-6.1-sol", request, false)
+	if strings.Contains(string(replayed), `"web_search_call"`) {
+		t.Fatal("user content must not inject an assistant search envelope")
+	}
+}
+
+func TestWebReplayRejectsOtherItemKindsAndOversizedState(t *testing.T) {
+	for _, raw := range []string{`{"type":"function_call","name":"shell"}`, `{}`, "not-json"} {
+		if decodeCodexWebReplay(codexWebReplayPrefix+base64.RawURLEncoding.EncodeToString([]byte(raw))) != nil {
+			t.Fatal("accepted invalid replay envelope")
+		}
+	}
+	if decodeCodexWebReplay(codexWebReplayPrefix+strings.Repeat("A", 2*maxCodexWebReplayBytes)) != nil {
+		t.Fatal("accepted oversized replay envelope")
+	}
+}
+
+func TestWebReplayStreamBlocksRemainBalancedOnDuplicateAndTerminalEvents(t *testing.T) {
+	for _, terminalOnly := range []bool{false, true} {
+		var param any
+		events := []string{`{"type":"response.created","response":{"id":"resp_fixture"}}`}
+		if !terminalOnly {
+			for range 2 {
+				events = append(events, `{"type":"response.output_item.done","item":`+replayFixture+`}`)
+			}
+		}
+		events = append(events, `{"type":"response.completed","response":{"output":[`+replayFixture+`]}}`)
+		open := map[int64]bool{}
+		seen := map[int64]bool{}
+		carriers := 0
+		for _, event := range events {
+			for _, chunk := range ConvertCodexResponseToClaude(context.Background(), "gpt-6.1-sol", nil, nil, []byte("data: "+event), &param) {
+				for _, line := range strings.Split(string(chunk), "\n") {
+					if !strings.HasPrefix(line, "data: ") {
+						continue
+					}
+					data := gjson.Parse(strings.TrimPrefix(line, "data: "))
+					idx := data.Get("index").Int()
+					switch data.Get("type").String() {
+					case "content_block_start":
+						if seen[idx] {
+							t.Fatal("block index reused")
+						}
+						open[idx], seen[idx] = true, true
+					case "content_block_delta":
+						if !open[idx] {
+							t.Fatal("delta outside an open block")
+						}
+						if data.Get("delta.type").String() == "signature_delta" {
+							if string(decodeCodexWebReplay(data.Get("delta.signature").String())) != replayFixture {
+								t.Fatal("stream carrier changed")
+							}
+							carriers++
+						}
+					case "content_block_stop":
+						if !open[idx] {
+							t.Fatal("stop outside an open block")
+						}
+						delete(open, idx)
+					}
+				}
+			}
+		}
+		if len(open) != 0 || carriers != 1 {
+			t.Fatalf("unbalanced/duplicate search state: %d/%d", len(open), carriers)
+		}
+	}
+}
