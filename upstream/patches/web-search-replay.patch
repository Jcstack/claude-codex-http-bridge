+// This internal envelope carries a native web-search output item through the
+// Claude transcript. It is not an encrypted reasoning signature or a credential.
+// Keeping state in the transcript makes replay independent of proxy memory.
+const codexWebReplayPrefix = "codex_web_search:v1:"
+const maxCodexWebReplayBytes = 1 << 20
+
+func validCodexWebReplay(item gjson.Result) bool {
+	if item.Get("type").String() != "web_search_call" || item.Get("id").String() == "" || item.Get("status").String() != "completed" {
+		return false
+	}
+	switch item.Get("action.type").String() {
+	case "search":
+		return item.Get("action.query").String() != "" || item.Get("action.queries.#").Int() > 0 || item.Get("action.sources.#").Int() > 0
+	case "open_page":
+		return item.Get("action.url").String() != ""
+	case "find":
+		return item.Get("action.url").String() != "" && item.Get("action.pattern").String() != ""
+	default:
+		return false
+	}
+}
+
+func decodeCodexWebReplay(signature string) []byte {
+	encoded := strings.TrimPrefix(signature, codexWebReplayPrefix)
+	if len(encoded) > base64.RawURLEncoding.EncodedLen(maxCodexWebReplayBytes) {
+		return nil
+	}
+	raw, err := base64.RawURLEncoding.DecodeString(encoded)
+	if err != nil || !json.Valid(raw) || !validCodexWebReplay(gjson.ParseBytes(raw)) {
+		return nil
+	}
+	return raw
+}
+
+func codexWebReplayBlock(item gjson.Result) []byte {
+	if len(item.Raw) > maxCodexWebReplayBytes || !validCodexWebReplay(item) {
+		return nil
+	}
+	block := []byte(`{"type":"thinking","thinking":"","signature":""}`)
+	block, _ = sjson.SetBytes(block, "signature", codexWebReplayPrefix+base64.RawURLEncoding.EncodeToString([]byte(item.Raw)))
+	return block
+}
