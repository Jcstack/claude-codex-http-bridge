+package handlers
+
+import (
+	"errors"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+type bridgeTrustedRetryError struct{}
+
+func (bridgeTrustedRetryError) Error() string { return "Synthetic deadline" }
+func (bridgeTrustedRetryError) SafeResponseHeaders() http.Header {
+	return http.Header{"Retry-After": {"17"}}
+}
+
+func TestBridgeRetryAdviceWithoutBroadPassthrough(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, trusted := range []bool{false, true} {
+		recorder := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(recorder)
+		c.Request = httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+		var cause error = errors.New("Synthetic provider failure")
+		want := "7"
+		if trusted {
+			cause = bridgeTrustedRetryError{}
+			want = "17"
+		}
+		handler := NewBaseAPIHandlers(nil, nil)
+		handler.WriteErrorResponse(c, &interfaces.ErrorMessage{StatusCode: 503, Error: cause, Addon: http.Header{
+			"Retry-After": {"7"}, "X-Should-Retry": {"false"}, "Set-Cookie": {"private=1"}, "X-Fixture-Private": {"private"},
+		}})
+		if recorder.Code != 503 || recorder.Header().Get("Retry-After") != want || recorder.Header().Get("X-Should-Retry") != "false" {
+			t.Fatal("native retry controls changed status or trusted deadline")
+		}
+		if recorder.Header().Get("Set-Cookie") != "" || recorder.Header().Get("X-Fixture-Private") != "" {
+			t.Fatal("broad private headers escaped the default policy")
+		}
+	}
+}
