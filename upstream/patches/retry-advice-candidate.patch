+package executor
+
+import (
+	"net/http"
+	"testing"
+)
+
+func TestBridgeCodexRetryVetoKeepsQuotaAndStatus(t *testing.T) {
+	for _, code := range []int{401, 403, 429, 503} {
+		body := []byte(`{"error":{"type":"server_error","message":"Synthetic provider failure"}}`)
+		if code == 429 {
+			body = []byte(`{"error":{"type":"usage_limit_reached","code":"usage_limit_reached","message":"Synthetic quota"}}`)
+		}
+		baseline := newCodexStatusErrWithHeaders(code, nil, body)
+		err := newCodexStatusErrWithHeaders(code, http.Header{"Retry-After": {"7"}, "X-Should-Retry": {"false"}, "Set-Cookie": {"private=1"}}, body)
+		if !err.IsRequestStop() || err.StatusCode() != baseline.StatusCode() || err.Error() != baseline.Error() || err.IsCredentialScoped() != baseline.IsCredentialScoped() || err.IsTransientRateLimit() != baseline.IsTransientRateLimit() {
+			t.Fatal("retry veto changed payload, status or credential scope")
+		}
+		if code == 429 && !err.IsCredentialScoped() {
+			t.Fatal("genuine quota scope lost")
+		}
+		headers := err.Headers()
+		if headers.Get("X-Should-Retry") != "false" || len(headers) != 2 {
+			t.Fatal("retry advice lost or private headers escaped")
+		}
+	}
+	err := newCodexStatusErrWithHeaders(503, http.Header{"X-Should-Retry": {"true"}}, []byte(`{"error":{"message":"Synthetic"}}`))
+	if err.IsRequestStop() {
+		t.Fatal("positive hint changed stop eligibility")
+	}
+}
