+)
+
+type bridgeRetryVetoError struct{ customStatusError }
+
+func (bridgeRetryVetoError) IsRequestStop() bool { return true }
+
+func TestBridgeRetryVetoPreventsRotationRefreshAndConfiguredContinuation(t *testing.T) {
+	for _, status := range []int{401, 429, 503} {
+		for _, mode := range []string{"execute", "count", "stream", "bootstrap"} {
+			for _, action := range []string{"continue", "continue-and-cooldown"} {
+				t.Run(fmt.Sprintf("%d/%s/%s", status, mode, action), func(t *testing.T) {
+					ctx := context.Background()
+					m := NewManager(nil, nil, nil)
+					m.SetRetryConfig(2, 2*time.Second, 5)
+					marker := "fixture-retry-veto"
+					rule := internalconfig.RequestScopedErrorRule{Status: status, Match: []string{marker}, Action: action}
+					delay := time.Second
+					failure := bridgeRetryVetoError{customStatusError{code: status, msg: marker, retryAfter: &delay}}
+					for index := 0; index < 2; index++ {
+						id := fmt.Sprintf("bridge-veto-%d-%s-%s-%d", status, mode, action, index)
+						auth := &Auth{ID: id, Provider: "codex", Status: StatusActive,
+							Attributes: map[string]string{"auth_kind": "oauth"},
+							Metadata: map[string]any{"access_token": "fixture-access", "refresh_token": "fixture-refresh",
+								"request_scoped_errors": []internalconfig.RequestScopedErrorRule{rule}}}
+						if _, matched := matchRequestScopedErrorAction(auth, failure.customStatusError, nil); !matched {
+							t.Fatal("the negative-control rule did not match an ordinary error")
+						}
+						registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{{ID: "gpt-5.5"}})
+						t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+						if _, err := m.Register(ctx, auth); err != nil {
+							t.Fatal(err)
+						}
+					}
+					calls := 0
+					reject := func(ctx context.Context, _ *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+						calls++
+						cliproxyexecutor.MarkUpstreamAttempt(ctx)
+						return cliproxyexecutor.Response{}, failure
+					}
+					exec := &issue6865Executor{id: "codex", executeFn: reject, countFn: reject,
+						streamFn: func(ctx context.Context, _ *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+							calls++
+							cliproxyexecutor.MarkUpstreamAttempt(ctx)
+							if mode != "bootstrap" {
+								return nil, failure
+							}
+							chunks := make(chan cliproxyexecutor.StreamChunk, 1)
+							chunks <- cliproxyexecutor.StreamChunk{Err: failure}
+							close(chunks)
+							return &cliproxyexecutor.StreamResult{Chunks: chunks}, nil
+						}}
+					m.RegisterExecutor(exec)
+					req, opts := cliproxyexecutor.Request{Model: "gpt-5.5"}, cliproxyexecutor.Options{}
+					var err error
+					switch mode {
+					case "execute":
+						_, err = m.Execute(ctx, []string{"codex"}, req, opts)
+					case "count":
+						_, err = m.ExecuteCount(ctx, []string{"codex"}, req, opts)
+					default:
+						_, err = m.ExecuteStream(ctx, []string{"codex"}, req, opts)
+					}
+					if err == nil || statusCodeFromError(err) != status || calls != 1 || exec.refreshCalls != 0 {
+						t.Fatalf("retry veto lost: status=%d attempts=%d refreshes=%d", statusCodeFromError(err), calls, exec.refreshCalls)
+					}
+				})
