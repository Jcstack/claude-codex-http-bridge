diff --git a/internal/util/retry_advice.go b/internal/util/retry_advice.go
new file mode 100644
--- /dev/null
+++ b/internal/util/retry_advice.go
@@ -0,0 +1,81 @@
+package util
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// RetryAdvice retains only validated client retry controls, never arbitrary headers.
+// The deadline starts when advice is captured; later processing cannot restart the wait.
+type RetryAdvice struct {
+	deadline    time.Time
+	hasDeadline bool
+	shouldRetry string
+}
+
+func NewRetryAdvice(headers http.Header, now time.Time) *RetryAdvice {
+	a := &RetryAdvice{}
+	if raw, ok := singleRetryHeader(headers, "X-Should-Retry"); ok && (raw == "false" || raw == "true") {
+		a.shouldRetry = raw
+	}
+	if raw, ok := singleRetryHeader(headers, "Retry-After"); ok {
+		digits := raw != ""
+		for _, c := range raw {
+			digits = digits && c >= '0' && c <= '9'
+		}
+		if seconds, err := strconv.ParseUint(raw, 10, 64); digits && err == nil && seconds <= uint64((1<<63-1)/time.Second) {
+			a.deadline = now.Add(time.Duration(seconds) * time.Second)
+			a.hasDeadline = true
+		} else if deadline, err := http.ParseTime(raw); err == nil {
+			a.deadline = deadline
+			a.hasDeadline = true
+		}
+	}
+	if !a.hasDeadline && a.shouldRetry == "" {
+		return nil
+	}
+	return a
+}
+
+func singleRetryHeader(headers http.Header, name string) (string, bool) {
+	var values []string
+	for key, candidate := range headers {
+		if strings.EqualFold(key, name) {
+			values = append(values, candidate...)
+		}
+	}
+	if len(values) != 1 || len(values[0]) > 128 {
+		return "", false
+	}
+	return strings.TrimSpace(values[0]), true
+}
+
+// Headers emits a fresh allowlisted map and a nonnegative remaining wait.
+func (a *RetryAdvice) Headers(now time.Time) http.Header {
+	if a == nil {
+		return nil
+	}
+	result := make(http.Header)
+	if a.shouldRetry != "" {
+		result.Set("X-Should-Retry", a.shouldRetry)
+	}
+	if a.hasDeadline {
+		remaining := a.deadline.Sub(now)
+		seconds := int64(0)
+		if remaining > 0 {
+			seconds = int64(remaining / time.Second)
+			if remaining%time.Second != 0 {
+				seconds++
+			}
+		}
+		result.Set("Retry-After", strconv.FormatInt(seconds, 10))
+	}
+	return result
+}
+
+// DisallowsRetry never promotes a true hint into extra attempts.
+func (a *RetryAdvice) DisallowsRetry() bool {
+	return a != nil && a.shouldRetry == "false"
+}
diff --git a/internal/util/retry_advice_test.go b/internal/util/retry_advice_test.go
new file mode 100644
--- /dev/null
+++ b/internal/util/retry_advice_test.go
@@ -0,0 +1,53 @@
+package util
+
+import (
+	"net/http"
+	"testing"
+	"time"
+)
+
+func TestBridgeRetryAdviceDeadlineAndPrivacy(t *testing.T) {
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	headers := http.Header{"Retry-After": {"7"}, "X-Should-Retry": {"false"}, "Set-Cookie": {"private=1"}, "X-Private": {"fixture-private"}}
+	advice := NewRetryAdvice(headers, now)
+	headers.Set("Retry-After", "999")
+	if !advice.DisallowsRetry() {
+		t.Fatal("explicit retry veto lost")
+	}
+	for _, tc := range []struct {
+		after time.Duration
+		want  string
+	}{{0, "7"}, {3 * time.Second, "4"}, {6500 * time.Millisecond, "1"}, {7 * time.Second, "0"}, {time.Minute, "0"}} {
+		got := advice.Headers(now.Add(tc.after))
+		if got.Get("Retry-After") != tc.want || got.Get("X-Should-Retry") != "false" || len(got) != 2 {
+			t.Fatal("retry deadline was restarted or private headers escaped")
+		}
+		got.Set("X-Should-Retry", "true")
+	}
+}
+
+func TestBridgeRetryAdviceStrictValues(t *testing.T) {
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	for _, tc := range []struct {
+		headers http.Header
+		wait    string
+		veto    string
+	}{
+		{nil, "", ""},
+		{http.Header{"Retry-After": {"0"}}, "0", ""},
+		{http.Header{"retry-after": {"7"}, "x-should-retry": {"true"}}, "7", "true"},
+		{http.Header{"Retry-After": {now.Add(7 * time.Second).Format(http.TimeFormat)}}, "7", ""},
+		{http.Header{"Retry-After": {now.Add(-time.Minute).Format(http.TimeFormat)}}, "0", ""},
+		{http.Header{"Retry-After": {"-1"}, "X-Should-Retry": {"secret"}}, "", ""},
+		{http.Header{"Retry-After": {"+7"}}, "", ""},
+		{http.Header{"Retry-After": {"7", "9"}, "X-Should-Retry": {"true", "false"}}, "", ""},
+		{http.Header{"Retry-After": {"7"}, "retry-after": {"9"}}, "", ""},
+		{http.Header{"Retry-After": {"18446744073709551615"}}, "", ""},
+	} {
+		advice := NewRetryAdvice(tc.headers, now)
+		got := advice.Headers(now)
+		if got.Get("Retry-After") != tc.wait || got.Get("X-Should-Retry") != tc.veto || advice.DisallowsRetry() {
+			t.Fatal("malformed, conflicting or unrelated retry controls were promoted")
+		}
+	}
+}
