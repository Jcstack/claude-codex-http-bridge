+func TestBridgeHTTPObservationClockAndConcurrentAttempts(t *testing.T) {
+	h := captureHTTPObservations(t)
+	now := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+	d := &CodexHTTPObservation{started: now, expires: now.Add(time.Hour), run: "0000000000000000", attempt: 1,
+		class: "main", route: "responses", status: 200}
+	d.emit(context.Background(), "decode", "ready", nil, now.Add(time.Second), now.Add(3*time.Second))
+	if !strings.Contains(h.snapshot()[0].Message, "elapsed_ms=3000 phase_elapsed_ms=2000") {
+		t.Fatal("phase duration restarted the overall observation clock")
+	}
+	var mu sync.Mutex
+	seen := make(map[uint64]bool)
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			req, _ := http.NewRequest(http.MethodPost, "http://example.invalid/v1/responses", nil)
+			d := NewCodexHTTPObservation(req)
+			mu.Lock()
+			if seen[d.attempt] {
+				t.Error("concurrent attempts shared an observation identity")
+			}
+			seen[d.attempt] = true
+			mu.Unlock()
+			d.Returned(req.Context(), &http.Response{StatusCode: 200}, nil)
+			d.Decode(req.Context(), func() error { return nil })
+		}()
+	}
+	wg.Wait()
+	if len(h.snapshot()) != 97 || len(seen) != 32 {
+		t.Fatal("concurrent phase observations were lost or repeated")
+	}
+}
