+// This error is request-scoped: a truncated tool item must not cool down
+// the account or be automatically retried against another credential.
+type codexIncompleteToolCallError struct {
+	statusErr
+}
+
+func newCodexIncompleteToolCallError() codexIncompleteToolCallError {
+	return codexIncompleteToolCallError{statusErr: statusErr{
+		code: http.StatusBadGateway,
+		msg:  "Upstream ended before a client tool call was complete.",
+	}}
+}
+
+func (codexIncompleteToolCallError) IsRequestScoped() bool {
+	return true
+}
+
+func codexUnconfirmedTerminalTool(eventType string, payload []byte) bool {
+	unconfirmed := false
+	gjson.GetBytes(payload, "response.output").ForEach(func(_, item gjson.Result) bool {
+		if item.Get("type").String() != "function_call" {
+			return true
+		}
+		status := item.Get("status").String()
+		if status != "completed" && (eventType == "response.incomplete" || status != "") {
+			unconfirmed = true
+			return false
+		}
+		return true
+	})
+	return unconfirmed
+}
+
 // Streamed Codex responses may emit response.output_item.done events while leaving
 // response.completed.response.output empty. Keep the stream path aligned with the
 // already-patched non-stream path by reconstructing response.output from those items.
