+// Never close an unconfirmed client tool block when a response is incomplete.
+// Returning an SSE error prevents a Claude client from executing a partially
+// generated call and does not replay actions that might already have completed.
+func codexIncompleteToolCallError() []byte {
+	return codexStreamErrorToClaudeError(gjson.Parse(`{"error":{"type":"api_error","message":"Upstream ended before a client tool call was complete."}}`))
+}
+
+func codexTerminalHasExplicitUnfinishedTool(responseData gjson.Result) bool {
+	unfinished := false
+	responseData.Get("output").ForEach(func(_, item gjson.Result) bool {
+		if item.Get("type").String() == "function_call" {
+			status := item.Get("status").String()
+			if status != "" && status != "completed" {
+				unfinished = true
+				return false
+			}
+		}
+		return true
+	})
+	return unfinished
+}
+
+func codexIncompleteHasUnconfirmedToolCalls(params *ConvertCodexResponseToClaudeParams, responseData gjson.Result) bool {
+	confirmed := make(map[*codexFunctionCallStream]bool)
+	unsafe := false
+	responseData.Get("output").ForEach(func(index, item gjson.Result) bool {
+		if item.Get("type").String() != "function_call" {
+			return true
+		}
+		keys := codexFunctionCallKeys(gjson.Result{}, item)
+		if itemOutputIndex := item.Get("output_index"); itemOutputIndex.Exists() {
+			keys = appendUniqueCodexFunctionCallKey(keys, "output:"+itemOutputIndex.Raw)
+		}
+		if index.Exists() {
+			keys = appendUniqueCodexFunctionCallKey(keys, "output:"+index.String())
+		}
+		call := codexFunctionCallForKeys(params, keys)
+		status := item.Get("status").String()
+		if status != "completed" && (status != "" || call == nil || !call.Done) {
+			unsafe = true
+			return false
+		}
+		if call != nil {
+			confirmed[call] = true
+		}
+		return true
+	})
+	if unsafe {
+		return true
+	}
+	for _, call := range params.FunctionCallQueue {
+		if call != nil && !call.Closed && !call.Done && !confirmed[call] {
+			return true
+		}
+	}
+	return false
+}
