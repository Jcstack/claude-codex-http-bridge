+++ b/internal/translator/codex/claude/codex_url_citations_test.go
@@ -0,0 +1,161 @@
+package claude
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const urlCitationFixture = `{"type":"url_citation","url":"https://fixture.invalid/docs?q=a&b=c","title":"Fixture source","start_index":0,"end_index":2}`
+
+func collectCitationStream(t *testing.T, events []string) []byte {
+	t.Helper()
+	var param any
+	blocks := map[int64][]byte{}
+	var indices []int64
+	open := map[int64]bool{}
+	for _, event := range events {
+		for _, chunk := range ConvertCodexResponseToClaude(context.Background(), "gpt-6.1-sol", nil, nil, []byte("data: "+event), &param) {
+			for _, line := range strings.Split(string(chunk), "\n") {
+				if !strings.HasPrefix(line, "data: ") {
+					continue
+				}
+				data := gjson.Parse(strings.TrimPrefix(line, "data: "))
+				idx := data.Get("index").Int()
+				switch data.Get("type").String() {
+				case "content_block_start":
+					if _, exists := blocks[idx]; exists {
+						t.Fatal("reused content index")
+					}
+					indices = append(indices, idx)
+					blocks[idx] = []byte(data.Get("content_block").Raw)
+					open[idx] = true
+				case "content_block_delta":
+					if !open[idx] {
+						t.Fatal("delta outside an open block")
+					}
+					switch data.Get("delta.type").String() {
+					case "text_delta":
+						blocks[idx], _ = sjson.SetBytes(blocks[idx], "text", gjson.GetBytes(blocks[idx], "text").String()+data.Get("delta.text").String())
+					case "citations_delta":
+						blocks[idx], _ = sjson.SetRawBytes(blocks[idx], "citations.-1", []byte(data.Get("delta.citation").Raw))
+					}
+				case "content_block_stop":
+					if !open[idx] {
+						t.Fatal("stop outside an open block")
+					}
+					delete(open, idx)
+				}
+			}
+		}
+	}
+	if len(open) != 0 {
+		t.Fatal("unclosed content blocks")
+	}
+	var content []json.RawMessage
+	for _, idx := range indices {
+		content = append(content, blocks[idx])
+	}
+	raw, _ := json.Marshal(content)
+	return raw
+}
+
+func assertURLCitationReplay(t *testing.T, content []byte, expectedText string) {
+	t.Helper()
+	part := gjson.GetBytes(content, "0")
+	if part.Get("text").String() != expectedText || part.Get("citations.#").Int() != 1 {
+		t.Fatalf("text/citation changed: %s", content)
+	}
+	if part.Get("citations.0.cited_text").String() != "" {
+		t.Fatal("model output must not be presented as a verbatim source quote")
+	}
+	request := []byte(`{"messages":[{"role":"assistant","content":[]}]}`)
+	request, _ = sjson.SetRawBytes(request, "messages.0.content", content)
+	replayed, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", request, false)
+	if err != nil || gjson.GetBytes(replayed, "input.0.content.0.annotations.#").Int() != 1 ||
+		string(canonicalCodexURLCitation(gjson.GetBytes(replayed, "input.0.content.0.annotations.0"))) != string(canonicalCodexURLCitation(gjson.Parse(urlCitationFixture))) {
+		t.Fatalf("native annotation lost/changed: %s (%v)", replayed, err)
+	}
+	request, _ = sjson.SetBytes(request, "messages.0.role", "user")
+	replayed, _ = ConvertClaudeRequestToCodex("gpt-6.1-sol", request, false)
+	if gjson.GetBytes(replayed, "input.0.content.0.annotations").Exists() {
+		t.Fatal("user content injected native assistant annotations")
+	}
+	edited, _ := sjson.SetBytes(content, "0.text", "Edited unrelated text")
+	if replayCodexURLCitations(gjson.GetBytes(edited, "0")) != nil {
+		t.Fatal("replayed offsets against changed transcript text")
+	}
+}
+
+func TestURLCitationsProgressiveDedupAndReplay(t *testing.T) {
+	part := `{"type":"output_text","text":"你好🌍. Final.","annotations":[` + urlCitationFixture + `]}`
+	item := `{"type":"message","role":"assistant","content":[` + part + `]}`
+	annotation := `{"type":"response.output_text.annotation.added","output_index":1,"content_index":0,"annotation":` + urlCitationFixture + `}`
+	content := collectCitationStream(t, []string{
+		`{"type":"response.content_part.added","output_index":1,"content_index":0,"part":{"type":"output_text"}}`,
+		`{"type":"response.output_text.delta","output_index":1,"content_index":0,"delta":"你好🌍."}`,
+		annotation, annotation,
+		`{"type":"response.output_text.delta","output_index":1,"content_index":0,"delta":" Final."}`,
+		`{"type":"response.content_part.done","output_index":1,"content_index":0,"part":` + part + `}`,
+		`{"type":"response.output_item.done","output_index":1,"item":` + item + `}`,
+		`{"type":"response.completed","response":{"output":[{},` + item + `]}}`,
+	})
+	assertURLCitationReplay(t, content, "你好🌍. Final.")
+}
+
+func TestURLCitationsDoneFallbackAndNonStream(t *testing.T) {
+	part := `{"type":"output_text","text":"Fixture answer.","annotations":[` + urlCitationFixture + `]}`
+	item := `{"type":"message","role":"assistant","content":[` + part + `]}`
+	for _, stage := range []string{"part", "item", "terminal", "whole-item", "non-stream"} {
+		t.Run(stage, func(t *testing.T) {
+			var content []byte
+			if stage == "non-stream" {
+				response := []byte(`{"type":"response.completed","response":{"output":[` + item + `]}}`)
+				content = []byte(gjson.GetBytes(ConvertCodexResponseToClaudeNonStream(context.Background(), "", nil, nil, response, nil), "content").Raw)
+			} else {
+				events := []string{}
+				if stage != "whole-item" {
+					events = append(events, `{"type":"response.output_text.delta","delta":"Fixture answer."}`)
+				}
+				if stage == "part" {
+					events = append(events, `{"type":"response.content_part.done","part":`+part+`}`)
+				}
+				if stage != "terminal" {
+					events = append(events, `{"type":"response.output_item.done","item":`+item+`}`)
+				}
+				events = append(events, `{"type":"response.completed","response":{"output":[`+item+`]}}`)
+				content = collectCitationStream(t, events)
+			}
+			assertURLCitationReplay(t, content, "Fixture answer.")
+		})
+	}
+}
+
+func TestURLCitationsRejectMalformedAndForeignMetadata(t *testing.T) {
+	annotation := gjson.Parse(urlCitationFixture)
+	block := codexCitedTextBlock("text", "Fixture answer.", gjson.Parse("["+urlCitationFixture+"]"))
+	for path, value := range map[string]any{"citations.0.url": "https://different.invalid", "citations.0.title": "Changed title",
+		"citations.0.encrypted_index": codexURLCitationPrefix + "malformed"} {
+		changed, _ := sjson.SetBytes(block, path, value)
+		if replayCodexURLCitations(gjson.ParseBytes(changed)) != nil {
+			t.Fatal("accepted inconsistent citation metadata")
+		}
+	}
+	for path, value := range map[string]any{"type": "file_citation", "url": "javascript:alert(1)", "start_index": -1, "end_index": 1.5} {
+		raw, _ := sjson.Set(annotation.Raw, path, value)
+		if canonicalCodexURLCitation(gjson.Parse(raw)) != nil {
+			t.Fatal("accepted invalid URL annotation")
+		}
