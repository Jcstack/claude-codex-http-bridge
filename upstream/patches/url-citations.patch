diff --git a/internal/translator/codex/claude/codex_url_citations.go b/internal/translator/codex/claude/codex_url_citations.go
new file mode 100644
index 0000000..f602efe
--- /dev/null
+++ b/internal/translator/codex/claude/codex_url_citations.go
@@ -0,0 +1,183 @@
+package claude
+
+import (
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strings"
+
+	translatorcommon "github.com/router-for-me/CLIProxyAPI/v8/internal/translator/common"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// The index is a bridge-owned, bounded continuation envelope, not an Anthropic
+// encrypted index or a credential. The hash detects edited/merged transcript
+// text before replaying offsets; it is not an authentication signature.
+const codexURLCitationPrefix = "codex_url_citation:v1:"
+const maxCodexURLCitationBytes = 64 << 10
+const maxCodexURLCitations = 1024
+
+type codexURLCitationEnvelope struct {
+	Annotation   json.RawMessage `json:"annotation"`
+	PrefixBytes  int             `json:"prefix_bytes"`
+	PrefixSHA256 string          `json:"prefix_sha256"`
+}
+
+func canonicalCodexURLCitation(annotation gjson.Result) []byte {
+	if len(annotation.Raw) > maxCodexURLCitationBytes || !annotation.IsObject() {
+		return nil
+	}
+	var fields struct {
+		Type       string `json:"type"`
+		URL        string `json:"url"`
+		Title      string `json:"title"`
+		StartIndex *int64 `json:"start_index"`
+		EndIndex   *int64 `json:"end_index"`
+	}
+	if json.Unmarshal([]byte(annotation.Raw), &fields) != nil || fields.Type != "url_citation" ||
+		fields.StartIndex == nil || fields.EndIndex == nil ||
+		*fields.StartIndex < 0 || *fields.EndIndex < *fields.StartIndex {
+		return nil
+	}
+	parsed, err := url.Parse(fields.URL)
+	if err != nil || (parsed.Scheme != "https" && parsed.Scheme != "http") || parsed.Host == "" || parsed.User != nil {
+		return nil
+	}
+	var value map[string]any
+	decoder := json.NewDecoder(strings.NewReader(annotation.Raw))
+	decoder.UseNumber()
+	if decoder.Decode(&value) != nil {
+		return nil
+	}
+	raw, err := json.Marshal(value)
+	if err != nil || len(raw) > maxCodexURLCitationBytes {
+		return nil
+	}
+	return raw
+}
+
+func codexURLCitation(raw []byte, prefixBytes int, digest []byte) []byte {
+	encoded, err := json.Marshal(codexURLCitationEnvelope{raw, prefixBytes, hex.EncodeToString(digest)})
+	if err != nil {
+		return nil
+	}
+	// A URL annotation locates the model's answer, not an exact source excerpt.
+	// Never label a generated claim as quoted source text.
+	block := []byte(`{"type":"web_search_result_location","url":"","title":"","cited_text":"","encrypted_index":""}`)
+	block, _ = sjson.SetBytes(block, "url", gjson.GetBytes(raw, "url").String())
+	block, _ = sjson.SetBytes(block, "title", gjson.GetBytes(raw, "title").String())
+	block, _ = sjson.SetBytes(block, "encrypted_index", codexURLCitationPrefix+base64.RawURLEncoding.EncodeToString(encoded))
+	return block
+}
+
+func appendCodexURLCitations(output []byte, params *ConvertCodexResponseToClaudeParams, outputIndex, contentIndex int64, annotations gjson.Result) []byte {
+	if !params.TextBlockOpen || params.CommentaryMessageOpen || !annotations.IsArray() ||
+		params.TextOutputIndex != outputIndex || params.TextContentIndex != contentIndex {
+		return output
+	}
+	if params.URLCitationIDs == nil {
+		params.URLCitationIDs = make(map[string]struct{})
+	}
+	annotations.ForEach(func(_, annotation gjson.Result) bool {
+		raw := canonicalCodexURLCitation(annotation)
+		if raw == nil || len(params.URLCitationIDs) >= maxCodexURLCitations {
+			return true
+		}
+		identity := fmt.Sprintf("%d:%d:%x", outputIndex, contentIndex, sha256.Sum256(raw))
+		if _, exists := params.URLCitationIDs[identity]; exists {
+			return true
+		}
+		citation := codexURLCitation(raw, params.URLCitationTextBytes, params.URLCitationTextHash.Sum(nil))
+		if citation == nil {
+			return true
+		}
+		delta := []byte(`{"type":"content_block_delta","index":0,"delta":{"type":"citations_delta","citation":{}}}`)
+		delta, _ = sjson.SetBytes(delta, "index", params.BlockIndex)
+		delta, _ = sjson.SetRawBytes(delta, "delta.citation", citation)
+		output = translatorcommon.AppendSSEEventBytes(output, "content_block_delta", delta, 2)
+		params.URLCitationIDs[identity] = struct{}{}
+		return true
+	})
+	return output
+}
+
+func appendCodexMessageURLCitations(output []byte, params *ConvertCodexResponseToClaudeParams, outputIndex int64, item gjson.Result) []byte {
+	if item.Get("type").String() != "message" || item.Get("phase").String() == "commentary" {
+		return output
+	}
+	item.Get("content").ForEach(func(index, part gjson.Result) bool {
+		if part.Get("type").String() == "output_text" {
+			output = appendCodexURLCitations(output, params, outputIndex, index.Int(), part.Get("annotations"))
+		}
+		return true
+	})
+	return output
+}
+
+func codexCitedTextBlock(blockType, text string, annotations gjson.Result) []byte {
+	block := codexMessageTextBlock(blockType, text)
+	if blockType != "text" || !annotations.IsArray() {
+		return block
+	}
+	var citations [][]byte
+	seen := make(map[string]struct{})
+	digest := sha256.Sum256([]byte(text))
+	annotations.ForEach(func(_, annotation gjson.Result) bool {
+		raw := canonicalCodexURLCitation(annotation)
+		if raw == nil || len(citations) >= maxCodexURLCitations {
+			return true
+		}
+		if _, exists := seen[string(raw)]; !exists {
+			citations = append(citations, codexURLCitation(raw, len(text), digest[:]))
+			seen[string(raw)] = struct{}{}
+		}
+		return true
+	})
+	if len(citations) > 0 {
+		block, _ = sjson.SetRawBytes(block, "citations", translatorcommon.JoinRawArray(citations))
+	}
+	return block
+}
+
+func replayCodexURLCitations(part gjson.Result) []byte {
+	var annotations [][]byte
+	seen := make(map[string]struct{})
+	text := part.Get("text").String()
+	part.Get("citations").ForEach(func(_, citation gjson.Result) bool {
+		index := citation.Get("encrypted_index").String()
+		if citation.Get("type").String() != "web_search_result_location" || !strings.HasPrefix(index, codexURLCitationPrefix) ||
+			len(index) > len(codexURLCitationPrefix)+base64.RawURLEncoding.EncodedLen(maxCodexURLCitationBytes+256) ||
+			len(annotations) >= maxCodexURLCitations {
+			return true
+		}
+		raw, err := base64.RawURLEncoding.DecodeString(strings.TrimPrefix(index, codexURLCitationPrefix))
+		var envelope codexURLCitationEnvelope
+		if err != nil || json.Unmarshal(raw, &envelope) != nil || envelope.PrefixBytes < 0 || envelope.PrefixBytes > len(text) {
+			return true
+		}
+		digest := sha256.Sum256([]byte(text[:envelope.PrefixBytes]))
+		if envelope.PrefixSHA256 != hex.EncodeToString(digest[:]) {
+			return true
+		}
+		annotation := gjson.ParseBytes(envelope.Annotation)
+		if annotation.Get("url").String() != citation.Get("url").String() || annotation.Get("title").String() != citation.Get("title").String() {
+			return true
+		}
+		canonical := canonicalCodexURLCitation(annotation)
+		if canonical != nil {
+			if _, exists := seen[string(canonical)]; !exists {
+				annotations = append(annotations, canonical)
+				seen[string(canonical)] = struct{}{}
+			}
+		}
+		return true
+	})
+	if len(annotations) == 0 {
+		return nil
+	}
+	return translatorcommon.JoinRawArray(annotations)
+}
