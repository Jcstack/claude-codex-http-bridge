+func TestConvertClaudeRequestToCodex_ToolRemovalRestrictsCallsWithoutRewritingPrefix(t *testing.T) {
+	tools := `[{"name":"ToolSearch","input_schema":{"type":"object"}},
+		{"name":"Read","input_schema":{"type":"object"}},
+		{"name":"Bash","input_schema":{"type":"object"}},
+		{"name":"mcp__demo__lookup","defer_loading":true,"input_schema":{"type":"object"}}]`
+	before := `{"tools":` + tools + `,"messages":[{"role":"user","content":"before"}]}`
+	after := `{"tools":` + tools + `,"messages":[
+		{"role":"user","content":"before"},
+		{"role":"assistant","content":[{"type":"tool_use","id":"search_1","name":"ToolSearch","input":{}}]},
+		{"role":"user","content":[{"type":"tool_result","tool_use_id":"search_1","content":[{"type":"tool_reference","tool_name":"mcp__demo__lookup"}]}]},
+		{"role":"system","content":[{"type":"tool_removal","tool":{"type":"tool_reference","name":"Bash"}},
+			{"type":"tool_removal","tool":{"type":"tool_reference","name":"mcp__demo__lookup"}}]},
+		{"role":"user","content":"after"}]}`
+	firstJSON, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(before), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondJSON, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(after), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := gjson.ParseBytes(firstJSON)
+	second := gjson.ParseBytes(secondJSON)
+	if first.Get("tools").Raw != second.Get("tools").Raw {
+		t.Fatalf("top-level tools changed after removal: %s", second.Get("tools").Raw)
+	}
+	if second.Get("tool_choice.type").String() != "allowed_tools" || second.Get("tool_choice.mode").String() != "auto" {
+		t.Fatalf("tool removal did not constrain callable tools: %s", second.Get("tool_choice").Raw)
+	}
+	allowed := second.Get("tool_choice.tools").Array()
+	if len(allowed) != 2 || allowed[0].Get("name").String() != "ToolSearch" || allowed[1].Get("name").String() != "Read" {
+		t.Fatalf("removed or unrevealed tools remained callable: %s", second.Get("tool_choice").Raw)
+	}
+	if !containsResponsesInputType(second.Get("input"), "additional_tools") {
+		t.Fatal("historical deferred reveal disappeared after removal")
+	}
+}
