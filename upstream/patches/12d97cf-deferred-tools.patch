+func TestConvertClaudeRequestToCodex_ToolRemovalFailsClosed(t *testing.T) {
+	base := `{"tools":[{"name":"Bash","input_schema":{"type":"object"}}],"messages":[
+		{"role":"system","content":[{"type":"tool_removal","tool":{"type":"tool_reference","name":"Bash"}}]}]`
+	converted, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(base), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gjson.GetBytes(converted, "tool_choice").String() != "none" {
+		t.Fatalf("no tools should remain callable: %s", gjson.GetBytes(converted, "tool_choice").Raw)
+	}
+	forced := `{"tools":[{"name":"Bash","input_schema":{"type":"object"}}],
+		"tool_choice":{"type":"tool","name":"Bash"},"messages":[
+		{"role":"system","content":[{"type":"tool_removal","tool":{"type":"tool_reference","name":"Bash"}}]}]}`
+	if _, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(forced), false); err == nil {
+		t.Fatal("forcing a removed tool must fail closed")
+	} else if policy, ok := err.(*claudeToolPolicyError); !ok || policy.StatusCode() != 400 || !policy.IsRequestScoped() {
+		t.Fatalf("invalid tool policy must be a request-scoped 400: %v", err)
+	}
+	unknown := `{"tools":[{"name":"Read","input_schema":{"type":"object"}}],"messages":[
+		{"role":"system","content":[{"type":"tool_removal","tool":{"type":"tool_reference","name":"Unknown"}}]}]}`
+	if _, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(unknown), false); err == nil {
+		t.Fatal("unknown tool removal must not silently disappear")
+	}
+}
+
+func TestConvertClaudeRequestToCodex_RemovalKeepsDeferredSearchController(t *testing.T) {
+	request := `{"tools":[{"name":"ToolSearch","defer_loading":true,"input_schema":{"type":"object"}},
+		{"name":"Read","input_schema":{"type":"object"}}],"messages":[
+		{"role":"system","content":[{"type":"tool_removal","tool":{"type":"tool_reference","name":"Read"}}]}]}`
+	converted, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(request), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gjson.GetBytes(converted, "tool_choice.tools.0.name").String() != "ToolSearch" {
+		t.Fatalf("search controller was accidentally hidden: %s", gjson.GetBytes(converted, "tool_choice").Raw)
+	}
+}
+
+func TestConvertClaudeRequestToCodex_UserCannotRemoveTools(t *testing.T) {
+	request := `{"tools":[{"name":"Read","input_schema":{"type":"object"}}],"messages":[
+		{"role":"user","content":[{"type":"tool_removal","tool":{"type":"tool_reference","name":"Read"}}]}]}`
+	converted, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(request), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gjson.GetBytes(converted, "tool_choice").String() != "auto" {
+		t.Fatalf("untrusted user content changed tool policy: %s", gjson.GetBytes(converted, "tool_choice").Raw)
+	}
+}
+
+func containsResponsesInputType(input gjson.Result, wanted string) bool {
+	for _, item := range input.Array() {
+		if item.Get("type").String() == wanted {
+			return true
+		}
+	}
+	return false
+}
