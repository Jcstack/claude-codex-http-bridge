+// Claude keeps its top-level tool prefix stable when a system message removes
+// a tool. Responses allowed_tools expresses the effective callable set without
+// rewriting that prefix or any historical additional_tools input items.
+func claudeToolChoiceAfterRemovals(root gjson.Result, toolNameMap map[string]string) ([]byte, bool, error) {
+	if !strings.Contains(root.Raw, "tool_removal") && !strings.Contains(root.Raw, `\u`) && !strings.Contains(root.Raw, `\U`) {
+		return nil, false, nil
+	}
+	definitions := make(map[string]gjson.Result)
+	active := make(map[string]bool)
+	var order []string
+	declare := func(def gjson.Result, offered bool) {
+		name := strings.TrimSpace(def.Get("name").String())
+		if name == "" || !def.IsObject() {
+			return
+		}
+		if _, exists := definitions[name]; !exists {
+			order = append(order, name)
+		}
+		definitions[name] = def
+		if offered {
+			active[name] = true
+		}
+	}
+	if tools := root.Get("tools"); tools.IsArray() {
+		for _, def := range tools.Array() {
+			declare(def, def.Get("defer_loading").Type != gjson.True || def.Get("name").String() == "ToolSearch")
+		}
+	}
+
+	toolSearchCallIDs := make(map[string]struct{})
+	removed := false
+	for _, message := range root.Get("messages").Array() {
+		role := message.Get("role").String()
+		content := message.Get("content")
+		if !content.IsArray() {
+			continue
+		}
+		for _, block := range content.Array() {
+			switch role {
+			case "assistant":
+				if block.Get("type").String() == "tool_use" && block.Get("name").String() == "ToolSearch" {
+					if id := block.Get("id").String(); id != "" {
+						toolSearchCallIDs[id] = struct{}{}
+					}
+				}
+			case "user":
+				if block.Get("type").String() != "tool_result" {
+					continue
+				}
+				id := block.Get("tool_use_id").String()
+				if _, ok := toolSearchCallIDs[id]; !ok {
+					continue
+				}
+				delete(toolSearchCallIDs, id)
+				for _, ref := range block.Get("content").Array() {
+					if ref.Get("type").String() != "tool_reference" {
+						continue
+					}
+					name := ref.Get("tool_name").String()
+					if name == "" {
+						name = ref.Get("name").String()
+					}
+					def := definitions[name]
+					if def.IsObject() && def.Get("defer_loading").Type == gjson.True &&
+						!isClaudeWebSearchToolType(def.Get("type").String()) {
+						active[name] = true
+					}
+				}
+			case "system":
+				typeName := block.Get("type").String()
+				if typeName != "tool_addition" && typeName != "tool_removal" {
+					continue
+				}
+				spec := block.Get("tool")
+				if typeName == "tool_addition" {
+					if def := spec.Get("definition"); def.IsObject() {
+						if !isClaudeWebSearchToolType(def.Get("type").String()) {
+							declare(def, true)
+						}
+						continue
+					}
+				}
+				name := spec.Get("name").String()
+				if name == "" {
+					name = spec.Get("tool_name").String()
+				}
+				if spec.Get("type").String() == "mcp_tool_reference" {
+					name = "mcp__" + spec.Get("server_name").String() + "__" + name
+				}
+				if typeName == "tool_removal" {
+					removed = true
+					if !definitions[name].IsObject() {
+						return nil, true, &claudeToolPolicyError{fmt.Sprintf("tool_removal references unknown tool %q", name)}
+					}
+					active[name] = false
+				} else if def := definitions[name]; def.IsObject() &&
+					!(isClaudeWebSearchToolType(def.Get("type").String()) && def.Get("defer_loading").Type == gjson.True) {
+					active[name] = true
+				}
+			}
+		}
+	}
+	if !removed {
+		return nil, false, nil
+	}
+
+	choice := root.Get("tool_choice")
+	choiceType := choice.Get("type").String()
+	if choiceType == "" && choice.Type == gjson.String {
+		choiceType = choice.String()
+	}
+	if choiceType == "none" {
+		return []byte(`"none"`), true, nil
+	}
+	if choiceType == "tool" {
+		name := choice.Get("name").String()
+		if !active[name] {
+			return nil, true, &claudeToolPolicyError{fmt.Sprintf("tool_choice forces removed or unavailable tool %q", name)}
+		}
+		return convertClaudeToolChoiceToCodex(choice, toolNameMap, buildClaudeWebSearchToolNameSet(root.Get("tools"))), true, nil
+	}
+
+	var allowed [][]byte
+	webSearchAdded := false
+	for _, name := range order {
+		if !active[name] {
+			continue
+		}
+		if isClaudeWebSearchToolType(definitions[name].Get("type").String()) {
+			if !webSearchAdded {
+				allowed = append(allowed, []byte(`{"type":"web_search"}`))
+				webSearchAdded = true
+			}
+			continue
+		}
+		short := toolNameMap[name]
+		if short == "" {
+			short = shortenNameIfNeeded(name)
+		}
+		spec := []byte(`{"type":"function","name":""}`)
+		spec, _ = sjson.SetBytes(spec, "name", short)
+		allowed = append(allowed, spec)
+	}
+	if len(allowed) == 0 {
+		if choiceType == "any" {
+			return nil, true, &claudeToolPolicyError{"tool_choice requires a tool after all tools were removed"}
+		}
+		return []byte(`"none"`), true, nil
+	}
+	mode := "auto"
+	if choiceType == "any" {
+		mode = "required"
+	}
+	out := []byte(`{"type":"allowed_tools","mode":"auto","tools":[]}`)
+	out, _ = sjson.SetBytes(out, "mode", mode)
+	out, _ = sjson.SetRawBytes(out, "tools", translatorcommon.JoinRawArray(allowed))
+	return out, true, nil
+}
+
+type claudeToolPolicyError struct{ message string }
+
+func (e *claudeToolPolicyError) Error() string         { return e.message }
+func (e *claudeToolPolicyError) StatusCode() int       { return 400 }
+func (e *claudeToolPolicyError) IsRequestScoped() bool { return true }
