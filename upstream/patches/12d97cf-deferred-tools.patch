+package claude
+
+import (
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestConvertClaudeRequestToCodex_DeferredToolsUseAppendOnlyReveal(t *testing.T) {
+	tools := `[
+		{"name":"ToolSearch","description":"Search tools","input_schema":{"type":"object"}},
+		{"name":"Read","description":"Read a file","input_schema":{"type":"object"}},
+		{"name":"mcp__demo__first","description":"First deferred tool","defer_loading":true,
+		 "input_schema":{"type":"object","properties":{"id":{"type":"string"}},"required":["id"]}},
+		{"name":"mcp__demo__second","description":"Second deferred tool","defer_loading":true,
+		 "input_schema":{"type":"object","properties":{"path":{"type":"string"}},"required":["path"]}},
+		{"name":"DeferredToolPlaceholder","description":"Never call","defer_loading":true,
+		 "input_schema":{"type":"object"}}
+	]`
+	before := `{"tools":` + tools + `,"messages":[{"role":"user","content":"find a tool"}]}`
+	after := `{"tools":` + tools + `,"messages":[
+		{"role":"user","content":"find a tool"},
+		{"role":"assistant","content":[{"type":"tool_use","id":"call_search","name":"ToolSearch","input":{"query":"demo"}}]},
+		{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_search","content":[
+			{"type":"tool_reference","tool_name":"mcp__demo__first"},
+			{"type":"tool_reference","tool_name":"unknown"},
+			{"type":"tool_reference","tool_name":"mcp__demo__first"},
+			{"type":"tool_reference","tool_name":"mcp__demo__second"}
+		]}]}
+	]}`
+	firstJSON, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(before), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	secondJSON, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(after), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	first := gjson.ParseBytes(firstJSON)
+	second := gjson.ParseBytes(secondJSON)
+	if first.Get("tools").Raw != second.Get("tools").Raw {
+		t.Fatalf("top-level tool prefix changed: before=%s after=%s", first.Get("tools").Raw, second.Get("tools").Raw)
+	}
+	gotTools := first.Get("tools").Array()
+	if len(gotTools) != 2 || gotTools[0].Get("name").String() != "ToolSearch" || gotTools[1].Get("name").String() != "Read" {
+		t.Fatalf("deferred schemas must be absent initially: %s", first.Get("tools").Raw)
+	}
+	inputs := second.Get("input").Array()
+	if len(inputs) != 4 || inputs[2].Get("type").String() != "function_call_output" || inputs[3].Get("type").String() != "additional_tools" {
+		t.Fatalf("reveal must follow tool output: %s", second.Get("input").Raw)
+	}
+	loaded := inputs[3].Get("tools").Array()
+	if len(loaded) != 2 || loaded[0].Get("name").String() != "mcp__demo__first" || loaded[1].Get("name").String() != "mcp__demo__second" {
+		t.Fatalf("unexpected loaded tools or reference order: %s", inputs[3].Raw)
+	}
+	if loaded[0].Get("parameters.required.0").String() != "id" || loaded[0].Get("defer_loading").Exists() {
+		t.Fatalf("loaded schema was not preserved or sanitized: %s", loaded[0].Raw)
+	}
+}
+
+func TestConvertClaudeRequestToCodex_DeferredRevealFollowsParallelResults(t *testing.T) {
+	request := `{"tools":[
+		{"name":"ToolSearch","input_schema":{"type":"object"}},
+		{"name":"Read","input_schema":{"type":"object"}},
+		{"name":"mcp__demo__lookup","defer_loading":true,"input_schema":{"type":"object"}}
+	],"messages":[
+		{"role":"assistant","content":[
+			{"type":"tool_use","id":"call_a","name":"ToolSearch","input":{}},
+			{"type":"tool_use","id":"call_b","name":"Read","input":{}}
+		]},
+		{"role":"user","content":[
+			{"type":"tool_result","tool_use_id":"call_a","content":[{"type":"tool_reference","tool_name":"mcp__demo__lookup"}]},
+			{"type":"tool_result","tool_use_id":"call_b","content":"ok"}
+		]}
+	]}`
+	converted, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(request), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	inputs := gjson.GetBytes(converted, "input").Array()
+	if len(inputs) != 5 || inputs[2].Get("type").String() != "function_call_output" ||
+		inputs[3].Get("type").String() != "function_call_output" || inputs[4].Get("type").String() != "additional_tools" {
+		t.Fatalf("parallel results must precede additional tools: %s", gjson.GetBytes(converted, "input").Raw)
+	}
+}
+
+func TestConvertClaudeRequestToCodex_UnrelatedToolCannotRevealDeferredTool(t *testing.T) {
+	request := `{"tools":[
+		{"name":"Read","input_schema":{"type":"object"}},
+		{"name":"mcp__demo__lookup","defer_loading":true,"input_schema":{"type":"object"}}
+	],"messages":[
+		{"role":"assistant","content":[{"type":"tool_use","id":"call_read","name":"Read","input":{}}]},
+		{"role":"user","content":[{"type":"tool_result","tool_use_id":"call_read","content":[
+			{"type":"tool_reference","tool_name":"mcp__demo__lookup"}
+		]}]}
+	]}`
+	converted, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(request), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, item := range gjson.GetBytes(converted, "input").Array() {
+		if item.Get("type").String() == "additional_tools" {
+			t.Fatalf("an unrelated tool result revealed a deferred schema: %s", item.Raw)
+		}
+	}
+}
+
+func TestConvertClaudeRequestToCodex_DropsAnthropicOnlyEagerFlag(t *testing.T) {
+	request := `{"tools":[{"name":"Read","eager_input_streaming":true,"allowed_callers":["direct"],
+	"cache_control":{"type":"ephemeral"},"future_anthropic_field":"unsafe",
+	"input_schema":{"type":"object"}}],
+	"messages":[{"role":"user","content":"read"}]}`
+	converted, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(request), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for field := range gjson.GetBytes(converted, "tools.0").Map() {
+		switch field {
+		case "type", "name", "description", "parameters", "strict":
+		default:
+			t.Fatalf("Anthropic-only tool field %q reached Responses: %s", field, gjson.GetBytes(converted, "tools").Raw)
+		}
+	}
+}
