+func TestConvertClaudeRequestToCodex_ToolRemovalThenReaddition(t *testing.T) {
+	request := `{"tools":[{"name":"Read","input_schema":{"type":"object"}},
+		{"name":"Bash","input_schema":{"type":"object"}}],"tool_choice":{"type":"any"},
+		"messages":[{"role":"system","content":[
+			{"type":"tool_removal","tool":{"type":"tool_reference","name":"Bash"}},
+			{"type":"tool_addition","tool":{"type":"tool_reference","name":"Bash"}}]}]}`
+	converted, err := ConvertClaudeRequestToCodex("gpt-6.1-sol", []byte(request), false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	result := gjson.ParseBytes(converted)
+	if result.Get("tool_choice.type").String() != "allowed_tools" || result.Get("tool_choice.mode").String() != "required" {
+		t.Fatalf("required tool choice was lost: %s", result.Get("tool_choice").Raw)
+	}
+	allowed := result.Get("tool_choice.tools").Array()
+	if len(allowed) != 2 || allowed[1].Get("name").String() != "Bash" {
+		t.Fatalf("readded tool not offered: %s", result.Get("tool_choice").Raw)
+	}
+}
